# Coaching Planner — Variabili d'Ambiente
#
# Copia questo file in .env.local per lo sviluppo locale.
# Non committare mai .env.local: è già escluso da .gitignore.

# Database PostgreSQL applicativo
# - Sviluppo locale: Postgres in container Docker (vedi docker-compose.yml)
#   DATABASE_URL="postgresql://user:password@localhost:5432/coaching_planner"
# - Produzione: stringa di connessione fornita dal provider del database
#   DATABASE_URL="postgresql://<utente>:<password>@<host-produzione>:5432/<database>"
DATABASE_URL="postgresql://user:password@localhost:5432/coaching_planner"

# Database PostgreSQL dedicato ai test end-to-end
# `npm run test:e2e` richiede un database separato, vuoto nelle tabelle applicative.
# Playwright lo migra, lo popola con i seed e lo ripulisce al termine della suite.
E2E_DATABASE_URL="postgresql://user:password@localhost:5432/coaching_planner_e2e"

# Auth.js secret (genera con: openssl rand -base64 32)
AUTH_SECRET="changeme-change-me-change-me-change-me"

# ── Sessione ─────────────────────────────────────────────────────
# Chiave segreta per la crittografia del cookie di sessione (HS256).
# Genera con: openssl rand -base64 32
SESSION_SECRET="changeme-change-me-change-me-change-me"

# ── Google OAuth ─────────────────────────────────────────────────
# Credenziali OAuth 2.0 create nella Google Cloud Console.
# 1. Vai su https://console.cloud.google.com/apis/credentials
# 2. Crea un progetto o selezionane uno esistente
# 3. Configura la schermata di consenso OAuth (tipo: Esterno, scope: openid email profile)
# 4. Crea credenziali > ID client OAuth > Applicazione Web
# 5. URI di reindirizzamento autorizzati: http://localhost:3000/api/auth/google/callback
# 6. Copia Client ID e Client Secret qui sotto
GOOGLE_CLIENT_ID="tuo-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tuo-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
