# Coaching Planner — Variabili d'Ambiente
#
# Copia questo file in .env.local per lo sviluppo locale.
# Non committare mai .env.local: è già escluso da .gitignore.

# Database PostgreSQL (locale = Postgres in container Docker, produzione = SiteGround)
DATABASE_URL="postgresql://user:password@localhost:5432/coaching_planner"

# Auth.js secret (genera con: openssl rand -base64 32)
AUTH_SECRET="changeme-change-me-change-me-change-me"
