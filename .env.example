# Coaching Planner — Variabili d'Ambiente
#
# Copia questo file in .env.local per lo sviluppo locale.
# Non committare mai .env.local: è già escluso da .gitignore.

# Database PostgreSQL
# - Sviluppo locale: Postgres in container Docker (vedi docker-compose.yml)
#   DATABASE_URL="postgresql://user:password@localhost:5432/coaching_planner"
# - Produzione: stringa di connessione fornita da SiteGround
#   DATABASE_URL="postgresql://<utente>:<password>@<host-produzione>:5432/<database>"
DATABASE_URL="postgresql://user:password@localhost:5432/coaching_planner"

# SiteGround PostgreSQL — Spike di connettività (US-004)
# Usata esclusivamente dallo script diagnostico scripts/siteground-connectivity-check.ts.
# Non sovrascrive DATABASE_URL: questa variabile serve solo per validare
# la raggiungibilità e la versione del database remoto SiteGround.
#
# IMPORTANTE:
# - SiteGround richiede TLS: includere sempre ?sslmode=require nella stringa
# - Non committare mai credenziali reali in questo file o in .env.local
# - Esempio:
#   SITEGROUND_DATABASE_URL="postgresql://<utente>:<password>@<host>:5432/<database>?sslmode=require"
SITEGROUND_DATABASE_URL="postgresql://utente:password@host-sg.siteground.com:5432/nome_db?sslmode=require"

# Auth.js secret (genera con: openssl rand -base64 32)
AUTH_SECRET="changeme-change-me-change-me-change-me"
