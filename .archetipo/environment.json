{
  "version": 1,
  "inputs": [
    "package.json",
    "package-lock.json",
    "prisma/schema.prisma",
    "prisma/migrations",
    "prisma/seed.ts",
    "prisma/seed-dati-demo.ts",
    "prisma.config.ts",
    "scripts/archetipo/ambiente.sh"
  ],
  "outputs": [
    "node_modules",
    "src/generated/prisma"
  ],
  "local_files": null,
  "prepare": [
    {
      "name": "npm-ci",
      "argv": [
        "npm",
        "ci",
        "--no-audit",
        "--no-fund"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "browser-playwright",
      "argv": [
        "npx",
        "playwright",
        "install",
        "chromium"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "migrazioni-e-seed",
      "argv": [
        "sh",
        "scripts/archetipo/ambiente.sh",
        "database"
      ],
      "timeout_seconds": 180
    }
  ],
  "probe": [
    {
      "name": "prisma-valido",
      "argv": [
        "sh",
        "scripts/archetipo/ambiente.sh",
        "probe-database"
      ],
      "timeout_seconds": 30
    }
  ],
  "cleanup": [
    {
      "name": "pulizia-artefatti",
      "argv": [
        "sh",
        "scripts/archetipo/ambiente.sh",
        "pulizia"
      ],
      "timeout_seconds": 30
    }
  ],
  "checks": {
    "verifica": {
      "name": "verifica",
      "argv": [
        "sh",
        "scripts/archetipo/ambiente.sh",
        "verifica"
      ],
      "timeout_seconds": 1800,
      "inputs": [
        "src",
        "tests",
        "prisma",
        "public",
        "scripts",
        "next.config.ts",
        "package.json",
        "playwright.config.ts",
        "vitest.config.ts",
        "eslint.config.mjs",
        "tsconfig.json"
      ],
      "cache": true
    }
  },
  "services": {
    "db": {
      "image": "postgres:17-alpine",
      "port": 5432,
      "env": {
        "POSTGRES_DB": "coaching_planner",
        "POSTGRES_PASSWORD": "password",
        "POSTGRES_USER": "user"
      },
      "data": "/var/lib/postgresql/data",
      "expose": {
        "DATABASE_URL": "postgresql://user:password@{host}:{port}/coaching_planner",
        "E2E_DATABASE_URL": "postgresql://user:password@{host}:{port}/coaching_planner_e2e"
      }
    }
  }
}
