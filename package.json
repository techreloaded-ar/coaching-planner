    "lint": "eslint && npm run lint:e2e-guardrails",
    "lint:e2e-guardrails": "tsx scripts/check-e2e-guardrails.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
