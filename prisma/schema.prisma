// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Utenti e Ruoli ──────────────────────────────────────────────

enum Ruolo {
  AMMINISTRATORE
  COLLABORATORE
}

// Chi fattura l'attività: FATTURABILE (collaboratore → Agile Reloaded →
// cliente), NON_FATTURABILE (solo collaboratore → Agile Reloaded),
// INVESTIMENTO (nessuna fattura).
enum CategoriaAttivita {
  FATTURABILE
  NON_FATTURABILE
  INVESTIMENTO
}

// Come Agile Reloaded fattura le trasferte al cliente per un'offerta:
// INCLUSA (già compresa nella tariffa), FORFETTARIA (importo fisso per
// ogni giorno di trasferta di ciascun collaboratore).
enum GestioneTrasferta {
  INCLUSA
  FORFETTARIA
}

// Come Agile Reloaded compensa il collaboratore: GIORNALIERA (importo per
// giornata da fatturare), FISSO_MENSILE (importo fisso per ogni mese in cui
// la tariffa è in vigore, a prescindere dalle ore).
enum ModalitaTariffa {
  GIORNALIERA
  FISSO_MENSILE
}

model Utente {
  id            String   @id @default(uuid())
  nome          String
  cognome       String
  email         String   @unique
  emailVerified DateTime?
  image         String?
  ruolo         Ruolo    @default(COLLABORATORE)
  attivo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relazioni
  account      Account[]
  session      Session[]
  collaboratore Collaboratore?
}

// Auth.js / NextAuth models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user Utente @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user Utente @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Collaboratori ────────────────────────────────────────────────

model Collaboratore {
  id                String   @id @default(uuid())
  userId            String   @unique
  nome              String
  cognome           String
  partitaIva        String?
  attivo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  utente          Utente          @relation(fields: [userId], references: [id])
  tariffe         TariffaCollaboratore[]
  righeAttivita    RigaAttivita[]
  abilitazioniOfferte AbilitazioneOfferta[]
  collegamentoCalendarioGoogle CollegamentoCalendarioGoogle?
  eventiCalendarioGestiti      EventoCalendarioGestito[]
  promemoriaFineMeseInviati    PromemoriaFineMeseInviato[]
}

// Storico tariffe: ogni voce vale dal mese indicato fino alla voce successiva.
// La tariffa di un mese è la voce con il mese di decorrenza più recente non
// successivo a quel mese; prima della prima voce il collaboratore non ha tariffa.
model TariffaCollaboratore {
  id              String          @id @default(uuid())
  collaboratoreId String
  validaDalMese   String // YYYY-MM
  modalita        ModalitaTariffa
  importo         Decimal         @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  collaboratore Collaboratore @relation(fields: [collaboratoreId], references: [id])

  @@unique([collaboratoreId, validaDalMese])
}

// ── Clienti ─────────────────────────────────────────────────────

model Cliente {
  id                String   @id @default(uuid())
  ragioneSociale    String
  partitaIva        String?
  codiceFiscale     String?
  indirizzo         String?
  citta             String?
  cap               String?
  provincia         String?
  pec               String?
  codiceDestinatario String?
  attivo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  offerte        Offerta[]
  righeAttivita  RigaAttivita[]
}

// ── Offerte ──────────────────────────────────────────────────────

model Offerta {
  id                String   @id @default(uuid())
  codice            String
  descrizione       String   @default("")
  clienteId         String
  tariffaGiornaliera Decimal?  @db.Decimal(10, 2)
  giorniPrevisti    Int?
  gestioneTrasferta GestioneTrasferta @default(INCLUSA)
  /// Importo fatturato al cliente per ogni giorno di trasferta; valorizzato solo se FORFETTARIA
  importoTrasfertaForfettaria Decimal? @db.Decimal(10, 2)
  attiva            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  righeAttivita  RigaAttivita[]
  abilitazioniCollaboratori AbilitazioneOfferta[]

  @@unique([codice, clienteId])
}

// ── Trasferte / Voci di Rimborso ────────────────────────────────

model VoceRimborsoTrasferta {
  id        String   @id @default(uuid())
  etichetta String
  importo   Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Attività Giornaliera ────────────────────────────────────────

model RigaAttivita {
  id                         String   @id @default(uuid())
  collaboratoreId            String
  clienteId                  String
  /// Facoltativa: ore caricate su un cliente prima che esista un'offerta
  /// restano "offerta da definire" finché il collaboratore non la indica.
  offertaId                  String?
  data                       DateTime @db.Date
  ore                        Decimal  @db.Decimal(4, 2)
  nota                       String?  @db.Text
  categoria                  CategoriaAttivita @default(FATTURABILE)
  rimborsoTrasfertaEtichetta String?
  rimborsoTrasfertaImporto   Decimal? @db.Decimal(10, 2)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  collaboratore Collaboratore @relation(fields: [collaboratoreId], references: [id])
  cliente       Cliente       @relation(fields: [clienteId], references: [id])
  // Restrict esplicito: un'offerta con righe non si cancella, le righe non
  // tornano "da definire" (il default di una relazione facoltativa è SetNull).
  offerta       Offerta?      @relation(fields: [offertaId], references: [id], onDelete: Restrict)

  // Sostiene la lettura del calendario mensile: filtro per collaboratore +
  // intervallo di date, con ordinamento stabile per data e creazione.
  @@index([collaboratoreId, data, createdAt], map: "RigaAttivita_collaboratore_data_createdAt_idx")
}

// ── Abilitazioni Collaboratore su Offerta ────────────────────────

model AbilitazioneOfferta {
  id              String   @id @default(uuid())
  collaboratoreId String
  offertaId       String
  createdAt       DateTime @default(now())

  collaboratore Collaboratore @relation(fields: [collaboratoreId], references: [id])
  offerta       Offerta       @relation(fields: [offertaId], references: [id])

  @@unique([collaboratoreId, offertaId])
}

// ── Calendario Google del collaboratore ─────────────────────────

// Consenso in sola lettura al calendario principale: il token di rinnovo è
// conservato cifrato (AES-256-GCM) e non lascia mai il server.
model CollegamentoCalendarioGoogle {
  id                  String   @id @default(uuid())
  collaboratoreId     String   @unique
  refreshTokenCifrato String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  collaboratore Collaboratore @relation(fields: [collaboratoreId], references: [id])
}

// Evento del calendario già confermato (diventato riga attività) o rifiutato:
// non viene più proposto al collaboratore.
model EventoCalendarioGestito {
  id                 String   @id @default(uuid())
  collaboratoreId    String
  eventoCalendarioId String
  createdAt          DateTime @default(now())

  collaboratore Collaboratore @relation(fields: [collaboratoreId], references: [id])

  @@unique([collaboratoreId, eventoCalendarioId])
}

// ── Promemoria di fine mese ──────────────────────────────────────

// Un invio automatico per collaboratore e mese: la chiave impedisce doppioni se il cron viene ripetuto.
model PromemoriaFineMeseInviato {
  collaboratoreId String
  mese            String // YYYY-MM
  inviatoIl       DateTime @default(now())

  collaboratore Collaboratore @relation(fields: [collaboratoreId], references: [id], onDelete: Cascade)

  @@id([collaboratoreId, mese])
}
