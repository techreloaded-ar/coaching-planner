# Import dello storico (fogli CLIENTI, OFFERTE, COACH, GIORNATE) nel Coaching Planner.
# Copia questo file in scripts/importa-storico/.env.importa-storico (ignorato da git).

# Database di destinazione. Lo script scrive solo qui, mai sul DATABASE_URL di .env.local.
DATABASE_URL="postgresql://utente:password@host:5432/database?sslmode=disable"

# Origine dei dati: link a un Google Sheets oppure percorso di un file .xlsx esportato dal foglio.
FOGLIO_ORIGINE="https://docs.google.com/spreadsheets/d/<id>/edit"
# FOGLIO_ORIGINE="/Users/me/Downloads/CP_DATI_export.xlsx"   (percorso assoluto: "~" non viene espansa)

# Accesso al Google Sheets con l'account Google Workspace: chiave JSON di un service account
# del progetto Google Cloud, con cui il foglio è condiviso in lettura (vedi README).
# Vuoto: il foglio deve essere condiviso come "Chiunque abbia il link può visualizzare".
GOOGLE_SERVICE_ACCOUNT_FILE="scripts/importa-storico/lavoro/service-account.json"

# Nomi delle schede (predefiniti: CLIENTI, OFFERTE, COACH, GIORNATE)
SCHEDA_CLIENTI=CLIENTI
SCHEDA_OFFERTE=OFFERTE
SCHEDA_COACH=COACH
SCHEDA_GIORNATE=GIORNATE

# Clienti fittizi da ignorare ovunque (clienti, offerte, giornate), separati da virgola
CLIENTI_ESCLUSI=ND
# Cliente interno: le sue giornate senza tipologia diventano NON_FATTURABILE
CLIENTE_INTERNO=AGILERELOADED

# Email dei coach da censire come amministratori (gli altri sono solo collaboratori).
# Se vuoto nessun amministratore: usa poi `npm run db:bootstrap-amministratore`.
EMAIL_AMMINISTRATORI=

# Importo forfettario di trasferta quando "Spese Forfait" è vuota (la tariffa giornaliera assente resta 0)
IMPORTO_TRASFERTA_FORFETTARIA_PREDEFINITO=220
# Mese di decorrenza della tariffa iniziale di ogni coach: deve coprire tutte le giornate
PRIMO_MESE_TARIFFA=2018-01

# Inferenza dei dati di fatturazione dei clienti con Claude Code (usa la sottoscrizione attiva
# nel terminale). Il comando gira senza alcun tool: legge solo il testo delle celle.
CLAUDE_COMANDO=claude
# Vuoto = modello predefinito della CLI
CLAUDE_MODELLO=
# Clienti per chiamata
CLAUDE_DIMENSIONE_LOTTO=20

# Cache dell'inferenza (così le prove a secco non richiamano Claude) e report delle righe sospese
CARTELLA_LAVORO=scripts/importa-storico/lavoro
