+  if (valore < 0) return "text-red-600 dark:text-red-400";
+  if (valore > 0) return "text-emerald-600 dark:text-emerald-400";
+  return "text-zinc-500 dark:text-zinc-400";
+}
+
+function etichettaPeriodo(meseDa: string, meseA: string): string {
