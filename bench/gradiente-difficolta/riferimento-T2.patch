+      errore: "Il mese finale non è valido: usa il formato AAAA-MM.",
+    });
+  });
+
+  it("rifiuta un mese iniziale successivo al finale", () => {
+    expect(validaPeriodoMarginalita("2026-04", "2026-03")).toEqual({
