+++ b/src/domain/marginalita/index.ts
@@ -0,0 +1,464 @@
+// Modulo di dominio Marginalità — funzioni pure per l'analisi di ricavi,
+// costi e margine su un periodo da mese a mese.
+//
+// Regole del committente:
+// - ricavi = giornate FATTURABILI × tariffa dell'offerta, calcolati mese per
+//   mese con lo stesso algoritmo del report Fatturazione Clienti, così che i
+//   ricavi di un cliente coincidano al centesimo con la somma degli imponibili
+//   manodopera mostrati da quel report per i mesi del periodo;
+// - costi = giornate LAVORATE (fatturabili e non fatturabili) × tariffa del
+//   collaboratore: una riga non fatturabile è costo senza ricavo;
+// - rimborsi trasferta esclusi da ricavi e costi perché passanti: sono esposti
+//   solo come informazione di riconciliazione col report Fatturazione Clienti;
+// - 1 giornata = 8 ore (ORE_PER_GIORNATA).
+//
+// Nessuna dipendenza da framework o Prisma.
+
+import { ORE_PER_GIORNATA } from "../types";
+import { parseTokenMese } from "../calendario";
+import {
+  calcolaReportFatturazioneClienti,
+  type RigaReportFatturazione,
+} from "../consuntivi";
+
+// ── Tipi di input ───────────────────────────────────────────────
+
+/**
+ * Riga elementare di attività per l'analisi della marginalità.
+ * Estende la riga del report fatturazione con il mese di competenza e la
+ * tariffa giornaliera del collaboratore (costo per la società).
+ */
+export interface RigaMarginalita extends RigaReportFatturazione {
+  /** Token YYYY-MM del mese di competenza della riga */
+  mese: string;
+  /** Tariffa giornaliera del collaboratore (serializzabile come stringa o numero) */
+  tariffaCollaboratoreGiornaliera: string | number;
+}
+
+// ── Tipi di output ──────────────────────────────────────────────
+
+/** Grandezze economiche comuni a ogni livello di aggregazione */
+export interface ImportiMarginalita {
+  /** Giornate fatturabili (ore fatturabili / 8) che generano ricavo */
+  giornateFatturabili: number;
+  /** Giornate non fatturabili (ore non fatturabili / 8): costo senza ricavo */
+  giornateNonFatturabili: number;
+  /** Ricavi: giornate fatturabili × tariffa offerta, a due decimali */
+  ricavi: string;
+  /** Costi: tutte le giornate lavorate × tariffa collaboratore, a due decimali */
+  costi: string;
+  /** Margine assoluto: ricavi − costi, a due decimali */
+  margine: string;
+  /**
+   * Margine percentuale sui ricavi (margine / ricavi × 100) a un decimale;
+   * `null` quando i ricavi sono zero e la percentuale non è definita.
+   */
+  marginePercentuale: string | null;
+}
+
+/** Dettaglio di un collaboratore (su una offerta o sull'intero cliente) */
+export interface VoceCollaboratoreMarginalita extends ImportiMarginalita {
+  collaboratoreId: string;
+  collaboratoreNome: string;
+  /** Tariffa giornaliera del collaboratore usata per i costi */
+  tariffaCollaboratoreGiornaliera: string;
+}
+
+/** Dettaglio di una offerta del cliente */
+export interface VoceOffertaMarginalita extends ImportiMarginalita {
+  offertaId: string;
+  offertaCodice: string;
+  offertaDescrizione: string;
+  /** Tariffa giornaliera dell'offerta usata per i ricavi */
+  tariffaOffertaGiornaliera: string;
+  perCollaboratore: VoceCollaboratoreMarginalita[];
+}
+
+/** Voce di analisi aggregata per cliente */
+export interface VoceClienteMarginalita extends ImportiMarginalita {
+  clienteId: string;
+  clienteRagioneSociale: string;
+  perOfferta: VoceOffertaMarginalita[];
+  /** Collaboratori che hanno lavorato per il cliente, aggregati su tutte le offerte */
+  perCollaboratore: VoceCollaboratoreMarginalita[];
+  /** Rimborsi trasferta del cliente nel periodo, esclusi dal margine (passanti) */
+  rimborsiTrasfertaEsclusi: string;
+}
+
+/** Analisi della marginalità complessiva del periodo */
+export interface ReportMarginalita {
+  perCliente: VoceClienteMarginalita[];
+  totali: ImportiMarginalita & { rimborsiTrasfertaEsclusi: string };
+}
+
+/** Periodo dell'analisi, estremi inclusi */
+export interface PeriodoMarginalita {
+  /** Token YYYY-MM del primo mese */
+  meseDa: string;
+  /** Token YYYY-MM dell'ultimo mese */
+  meseA: string;
+}
+
+/** Esito della validazione del periodo richiesto */
+export type EsitoValidazionePeriodo =
+  | { valido: true; periodo: PeriodoMarginalita }
+  | { valido: false; errore: string };
+
+// ── Validazione periodo ─────────────────────────────────────────
+
+/**
+ * Valida il periodo "da mese a mese" richiesto dall'amministratore.
+ *
+ * Regole:
+ * - entrambi gli estremi devono essere token YYYY-MM validi;
+ * - il mese iniziale non può essere successivo al mese finale;
+ * - un periodo di un solo mese (da = a) è ammesso.
+ */
+export function validaPeriodoMarginalita(
+  meseDa: string,
+  meseA: string,
+): EsitoValidazionePeriodo {
+  if (!parseTokenMese(meseDa)) {
+    return {
+      valido: false,
+      errore: "Il mese iniziale non è valido: usa il formato AAAA-MM.",
+    };
+  }
+  if (!parseTokenMese(meseA)) {
+    return {
+      valido: false,
+      errore: "Il mese finale non è valido: usa il formato AAAA-MM.",
+    };
+  }
+  // I token YYYY-MM sono confrontabili lessicograficamente.
+  if (meseDa > meseA) {
+    return {
+      valido: false,
+      errore: "Il mese iniziale non può essere successivo al mese finale.",
+    };
+  }
+  return { valido: true, periodo: { meseDa, meseA } };
+}
+
+// ── Aritmetica in centesimi ─────────────────────────────────────
+
+/** Converte un importo a due decimali (stringa o numero) in centesimi interi */
+function inCentesimi(importo: string | number): number {
+  const valore = Number(importo);
+  return Number.isFinite(valore) ? Math.round(valore * 100) : 0;
+}
+
+/** Converte ore (Decimal(4,2)) in centesimi di ora interi, per somme esatte */
+function inCentesimiDiOra(ore: number): number {
+  return Number.isFinite(ore) ? Math.round(ore * 100) : 0;
+}
+
+function formattaCentesimi(centesimi: number): string {
+  return (centesimi / 100).toFixed(2);
+}
+
+function giornateDaCentesimiDiOra(centesimiDiOra: number): number {
+  return centesimiDiOra / 100 / ORE_PER_GIORNATA;
+}
+
+/**
+ * Costo in centesimi di un monte ore a una tariffa giornaliera:
+ * ore / 8 × tariffa = (centesimiDiOra × centesimiTariffa) / (100 × 8) centesimi.
+ * Il prodotto è intero e resta ben sotto 2^53: l'unico arrotondamento è finale.
+ */
+function costoInCentesimi(centesimiDiOra: number, centesimiTariffa: number): number {
+  return Math.round(
+    (centesimiDiOra * centesimiTariffa) / (100 * ORE_PER_GIORNATA),
+  );
+}
+
+// ── Accumulatori ────────────────────────────────────────────────
+
+interface Accumulatore {
+  centesimiDiOraFatturabili: number;
+  centesimiDiOraNonFatturabili: number;
+  ricaviCentesimi: number;
+  costiCentesimi: number;
+}
+
+function nuovoAccumulatore(): Accumulatore {
+  return {
+    centesimiDiOraFatturabili: 0,
+    centesimiDiOraNonFatturabili: 0,
+    ricaviCentesimi: 0,
+    costiCentesimi: 0,
+  };
+}
+
+function sommaIn(destinazione: Accumulatore, sorgente: Accumulatore): void {
+  destinazione.centesimiDiOraFatturabili += sorgente.centesimiDiOraFatturabili;
+  destinazione.centesimiDiOraNonFatturabili +=
+    sorgente.centesimiDiOraNonFatturabili;
+  destinazione.ricaviCentesimi += sorgente.ricaviCentesimi;
+  destinazione.costiCentesimi += sorgente.costiCentesimi;
+}
+
+function importiDa(accumulatore: Accumulatore): ImportiMarginalita {
+  const margineCentesimi =
+    accumulatore.ricaviCentesimi - accumulatore.costiCentesimi;
+  return {
+    giornateFatturabili: giornateDaCentesimiDiOra(
+      accumulatore.centesimiDiOraFatturabili,
+    ),
+    giornateNonFatturabili: giornateDaCentesimiDiOra(
+      accumulatore.centesimiDiOraNonFatturabili,
+    ),
+    ricavi: formattaCentesimi(accumulatore.ricaviCentesimi),
+    costi: formattaCentesimi(accumulatore.costiCentesimi),
+    margine: formattaCentesimi(margineCentesimi),
+    marginePercentuale:
+      accumulatore.ricaviCentesimi === 0
+        ? null
+        : ((margineCentesimi / accumulatore.ricaviCentesimi) * 100).toFixed(1),
+  };
+}
+
+interface FogliaCollaboratore extends Accumulatore {
+  collaboratoreId: string;
+  collaboratoreNome: string;
+  centesimiTariffaCollaboratore: number;
+}
+
+interface NodoOfferta {
+  offertaId: string;
+  offertaCodice: string;
+  offertaDescrizione: string;
+  centesimiTariffaOfferta: number;
+  collaboratori: Map<string, FogliaCollaboratore>;
+}
+
+interface NodoCliente {
+  clienteId: string;
+  clienteRagioneSociale: string;
+  offerte: Map<string, NodoOfferta>;
+  rimborsiCentesimi: number;
+}
+
+function confrontaCollaboratori(
+  a: VoceCollaboratoreMarginalita,
+  b: VoceCollaboratoreMarginalita,
+): number {
+  return a.collaboratoreNome.localeCompare(b.collaboratoreNome);
+}
+
+function voceCollaboratore(
+  foglia: FogliaCollaboratore,
+): VoceCollaboratoreMarginalita {
+  return {
+    collaboratoreId: foglia.collaboratoreId,
+    collaboratoreNome: foglia.collaboratoreNome,
+    tariffaCollaboratoreGiornaliera: formattaCentesimi(
+      foglia.centesimiTariffaCollaboratore,
+    ),
+    ...importiDa(foglia),
+  };
+}
+
+// ── Calcolo principale ──────────────────────────────────────────
+
+/**
+ * Calcola l'analisi della marginalità per cliente, con dettaglio per offerta
+ * e per collaboratore, a partire dalle righe attività del periodo.
+ *
+ * Ricavi: per ogni mese viene invocato `calcolaReportFatturazioneClienti` e si
+ * sommano, in centesimi, gli imponibili allocati per collaboratore. Poiché il
+ * report fatturazione ancora quell'allocazione all'imponibile manodopera del
+ * cliente, i ricavi di ogni cliente coincidono esattamente con la somma degli
+ * imponibili manodopera mensili del report Fatturazione Clienti; offerte e
+ * collaboratori sommano esattamente al totale del cliente.
+ *
+ * Costi: per ogni coppia (offerta, collaboratore) le ore lavorate del periodo,
+ * fatturabili e non, sono valorizzate alla tariffa del collaboratore e
+ * arrotondate al centesimo una sola volta; i livelli superiori sommano i
+ * centesimi delle foglie, quindi i totali quadrano per costruzione.
+ *
+ * Ordinamento: clienti per ragione sociale, offerte per codice, collaboratori
+ * per nome. Clienti senza ore lavorate nel periodo sono omessi (i loro
+ * eventuali rimborsi restano nel totale dei rimborsi esclusi).
+ */
+export function calcolaReportMarginalita(
+  righe: RigaMarginalita[],
+): ReportMarginalita {
+  const clienti = new Map<string, NodoCliente>();
+  const righePerMese = new Map<string, RigaMarginalita[]>();
+  let rimborsiTotaliCentesimi = 0;
+
+  // 1. Struttura cliente → offerta → collaboratore, ore e rimborsi
+  for (const riga of righe) {
+    let cliente = clienti.get(riga.clienteId);
+    if (!cliente) {
+      cliente = {
+        clienteId: riga.clienteId,
+        clienteRagioneSociale: riga.clienteRagioneSociale,
+        offerte: new Map(),
+        rimborsiCentesimi: 0,
+      };
+      clienti.set(riga.clienteId, cliente);
+    }
+
+    let offerta = cliente.offerte.get(riga.offertaId);
+    if (!offerta) {
+      offerta = {
+        offertaId: riga.offertaId,
+        offertaCodice: riga.offertaCodice,
+        offertaDescrizione: riga.offertaDescrizione,
+        centesimiTariffaOfferta: inCentesimi(riga.tariffaOffertaGiornaliera),
+        collaboratori: new Map(),
+      };
+      cliente.offerte.set(riga.offertaId, offerta);
+    }
+
+    let foglia = offerta.collaboratori.get(riga.collaboratoreId);
+    if (!foglia) {
+      foglia = {
+        collaboratoreId: riga.collaboratoreId,
+        collaboratoreNome: riga.collaboratoreNome,
+        centesimiTariffaCollaboratore: inCentesimi(
+          riga.tariffaCollaboratoreGiornaliera,
+        ),
+        ...nuovoAccumulatore(),
+      };
+      offerta.collaboratori.set(riga.collaboratoreId, foglia);
+    }
+
+    const centesimiDiOra = inCentesimiDiOra(riga.ore);
+    if (riga.fatturabile) {
+      foglia.centesimiDiOraFatturabili += centesimiDiOra;
+    } else {
+      foglia.centesimiDiOraNonFatturabili += centesimiDiOra;
+    }
+
+    if (riga.rimborsoTrasfertaImporto != null) {
+      const rimborso = inCentesimi(riga.rimborsoTrasfertaImporto);
+      cliente.rimborsiCentesimi += rimborso;
+      rimborsiTotaliCentesimi += rimborso;
+    }
+
+    const righeMese = righePerMese.get(riga.mese);
+    if (righeMese) {
+      righeMese.push(riga);
+    } else {
+      righePerMese.set(riga.mese, [riga]);
+    }
+  }
+
+  // 2. Ricavi: stesso calcolo del report Fatturazione Clienti, mese per mese
+  for (const righeMese of righePerMese.values()) {
+    const reportMese = calcolaReportFatturazioneClienti(righeMese);
+    for (const voceCliente of reportMese.perCliente) {
+      const cliente = clienti.get(voceCliente.clienteId);
+      for (const voceOfferta of voceCliente.perOfferta) {
+        const offerta = cliente?.offerte.get(voceOfferta.offertaId);
+        for (const voceCollaboratore of voceOfferta.perCollaboratore) {
+          const foglia = offerta?.collaboratori.get(
+            voceCollaboratore.collaboratoreId,
+          );
+          if (foglia) {
+            foglia.ricaviCentesimi += inCentesimi(voceCollaboratore.imponibile);
+          }
+        }
+      }
+    }
+  }
+
+  // 3. Costi sulle foglie e aggregazione verso l'alto
+  const totali = nuovoAccumulatore();
+  const perCliente: VoceClienteMarginalita[] = [];
+
+  for (const cliente of clienti.values()) {
+    const accumulatoreCliente = nuovoAccumulatore();
+    const collaboratoriCliente = new Map<string, FogliaCollaboratore>();
+    const perOfferta: VoceOffertaMarginalita[] = [];
+
+    for (const offerta of cliente.offerte.values()) {
+      const accumulatoreOfferta = nuovoAccumulatore();
+      const perCollaboratore: VoceCollaboratoreMarginalita[] = [];
+
+      for (const foglia of offerta.collaboratori.values()) {
+        foglia.costiCentesimi = costoInCentesimi(
+          foglia.centesimiDiOraFatturabili + foglia.centesimiDiOraNonFatturabili,
+          foglia.centesimiTariffaCollaboratore,
+        );
+        sommaIn(accumulatoreOfferta, foglia);
+
+        let fogliaCliente = collaboratoriCliente.get(foglia.collaboratoreId);
+        if (!fogliaCliente) {
+          fogliaCliente = {
+            collaboratoreId: foglia.collaboratoreId,
+            collaboratoreNome: foglia.collaboratoreNome,
+            centesimiTariffaCollaboratore: foglia.centesimiTariffaCollaboratore,
+            ...nuovoAccumulatore(),
+          };
+          collaboratoriCliente.set(foglia.collaboratoreId, fogliaCliente);
+        }
+        sommaIn(fogliaCliente, foglia);
+
+        perCollaboratore.push(voceCollaboratore(foglia));
+      }
+
+      const oreOfferta =
+        accumulatoreOfferta.centesimiDiOraFatturabili +
+        accumulatoreOfferta.centesimiDiOraNonFatturabili;
+      if (oreOfferta === 0) {
+        continue;
+      }
+
+      sommaIn(accumulatoreCliente, accumulatoreOfferta);
+      perOfferta.push({
+        offertaId: offerta.offertaId,
+        offertaCodice: offerta.offertaCodice,
+        offertaDescrizione: offerta.offertaDescrizione,
+        tariffaOffertaGiornaliera: formattaCentesimi(
+          offerta.centesimiTariffaOfferta,
+        ),
+        ...importiDa(accumulatoreOfferta),
+        perCollaboratore: perCollaboratore
+          .filter(
+            (voce) =>
+              voce.giornateFatturabili + voce.giornateNonFatturabili > 0,
+          )
+          .sort(confrontaCollaboratori),
+      });
+    }
+
+    if (perOfferta.length === 0) {
+      continue;
+    }
+
+    sommaIn(totali, accumulatoreCliente);
+    perOfferta.sort((a, b) => a.offertaCodice.localeCompare(b.offertaCodice));
+    perCliente.push({
+      clienteId: cliente.clienteId,
+      clienteRagioneSociale: cliente.clienteRagioneSociale,
+      ...importiDa(accumulatoreCliente),
+      perOfferta,
+      perCollaboratore: Array.from(collaboratoriCliente.values())
+        .filter(
+          (foglia) =>
+            foglia.centesimiDiOraFatturabili +
+              foglia.centesimiDiOraNonFatturabili >
+            0,
+        )
+        .map(voceCollaboratore)
+        .sort(confrontaCollaboratori),
+      rimborsiTrasfertaEsclusi: formattaCentesimi(cliente.rimborsiCentesimi),
+    });
+  }
+
+  perCliente.sort((a, b) =>
+    a.clienteRagioneSociale.localeCompare(b.clienteRagioneSociale),
+  );
+
+  return {
+    perCliente,
+    totali: {
+      ...importiDa(totali),
+      rimborsiTrasfertaEsclusi: formattaCentesimi(rimborsiTotaliCentesimi),
+    },
+  };
+}
