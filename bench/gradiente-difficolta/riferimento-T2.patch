+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+const { mockRigaAttivita } = vi.hoisted(() => ({
+  mockRigaAttivita: {
+    findMany: vi.fn(),
+  },
+}));
+
+vi.mock("@/lib/db", () => ({
+  db: { rigaAttivita: mockRigaAttivita },
+}));
+
+const { mockRichiediRuoloApi, ErroreAutorizzazioneFinto } = vi.hoisted(() => {
+  class ErroreAutorizzazioneFinto extends Error {
+    constructor(readonly statusCode: 401 | 403) {
+      super(`Errore ${statusCode}`);
+    }
+  }
+  return { mockRichiediRuoloApi: vi.fn(), ErroreAutorizzazioneFinto };
+});
+
+vi.mock("@/lib/dal", () => ({
+  richiediRuoloApi: mockRichiediRuoloApi,
+}));
+
+import { reportMarginalitaPeriodo } from "@/lib/report";
+
+/** Simula il Decimal Prisma con un oggetto dotato di toString() */
+function decimale(valore: string) {
+  return { toString: () => valore };
+}
+
+/** Riga attività come restituita da Prisma, con relazioni incluse */
+function rigaPrisma(modifiche: {
+  data: string;
+  ore: string;
+  fatturabile?: boolean;
+  rimborso?: string | null;
+}) {
+  return {
+    id: `riga-${modifiche.data}`,
+    collaboratoreId: "col-1",
+    clienteId: "cli-1",
+    offertaId: "off-1",
+    data: new Date(`${modifiche.data}T00:00:00.000Z`),
+    ore: decimale(modifiche.ore),
+    nota: null,
+    fatturabile: modifiche.fatturabile ?? true,
+    rimborsoTrasfertaEtichetta: modifiche.rimborso ? "Trasferta" : null,
+    rimborsoTrasfertaImporto: modifiche.rimborso ? decimale(modifiche.rimborso) : null,
+    createdAt: new Date(),
+    updatedAt: new Date(),
+    offerta: {
+      id: "off-1",
+      codice: "OFF-001",
+      descrizione: "Coaching",
+      tariffaGiornaliera: decimale("640.00"),
+    },
+    cliente: { id: "cli-1", ragioneSociale: "Cliente Uno" },
+    collaboratore: {
+      nome: "Mario",
+      cognome: "Rossi",
+      tariffaGiornaliera: decimale("400.00"),
+    },
+  };
+}
+
+describe("reportMarginalitaPeriodo", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockRichiediRuoloApi.mockResolvedValue({ utenteId: "admin", ruolo: "AMMINISTRATORE" });
+    mockRigaAttivita.findMany.mockResolvedValue([]);
+  });
+
+  it("richiede il ruolo amministratore e non legge dati se l'utente non è autorizzato", async () => {
+    mockRichiediRuoloApi.mockRejectedValue(new ErroreAutorizzazioneFinto(403));
+
+    await expect(reportMarginalitaPeriodo("2026-01", "2026-03")).rejects.toMatchObject({
