+          >
+            <h2 className="mb-4 text-[11.5px] font-bold uppercase tracking-[0.06em] text-white/80">
+              Totale del periodo — <span className="capitalize">{periodo}</span>
+            </h2>
+            <div className="flex flex-wrap items-end gap-x-[26px] gap-y-4">
+              {(
+                [
+                  ["Ricavi", formattaEuro(totali.ricavi), "marginalita-totale-ricavi"],
+                  ["Costi collaboratori", formattaEuro(totali.costi), "marginalita-totale-costi"],
+                  ["Margine", formattaEuro(totali.margine), "marginalita-totale-margine"],
+                  ["Margine %", formattaPercentuale(totali.marginePercentuale), "marginalita-totale-percentuale"],
+                  ["Rimborsi esclusi", formattaEuro(totali.rimborsiTrasfertaEsclusi), "marginalita-totale-rimborsi-esclusi"],
+                ] as const
+              ).map(([etichetta, valore, testId]) => (
+                <div key={testId}>
+                  <div className="mb-[5px] text-[11.5px] font-semibold text-white/80">
+                    {etichetta}
+                  </div>
+                  <div
+                    data-testid={testId}
+                    className="text-[19px] font-bold -tracking-[0.02em] tabular-nums"
+                  >
+                    {valore}
+                  </div>
+                </div>
+              ))}
+            </div>
+          </section>
+        </>
+      )}
+    </div>
+  );
+}
