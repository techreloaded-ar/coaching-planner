+import { richiediRuolo } from "@/lib/dal";
+import { reportMarginalitaPeriodo } from "@/lib/report";
+import { formattaTokenMese, tokenMeseCorrente } from "@/domain/calendario";
+import ReportMarginalita from "./report-marginalita";
+
+/** Primo valore di un search param che può arrivare ripetuto. */
+function primoValore(valore: string | string[] | undefined): string | undefined {
+  return Array.isArray(valore) ? valore[0] : valore;
+}
+
+export default async function ReportMarginalitaPage({
+  searchParams,
+}: {
+  searchParams: Promise<{ [chiave: string]: string | string[] | undefined }>;
+}) {
+  await richiediRuolo("AMMINISTRATORE");
+
+  const params = await searchParams;
+  const meseCorrente = tokenMeseCorrente();
+  const meseInizioAnno = formattaTokenMese(Number(meseCorrente.slice(0, 4)), 1);
+
+  // Periodo: se manca un estremo vale l'altro, se mancano entrambi il mese corrente
+  const daRichiesto = primoValore(params.da)?.trim() || undefined;
+  const aRichiesto = primoValore(params.a)?.trim() || undefined;
+  const meseDa = daRichiesto ?? aRichiesto ?? meseCorrente;
+  const meseA = aRichiesto ?? daRichiesto ?? meseCorrente;
+
+  // Dati del report — già serializzabili (stringhe e numeri)
+  const risultato = await reportMarginalitaPeriodo(meseDa, meseA);
+
+  return (
+    <div>
+      {/* Intestazione view */}
+      <div className="mb-[22px] flex flex-wrap items-start justify-between gap-4">
+        <div>
+          <div className="mb-1 text-[12px] font-semibold uppercase tracking-[.04em] text-zinc-400 dark:text-zinc-500">
+            Reportistica
+          </div>
+          <h1 className="text-[23px] font-bold tracking-tight text-zinc-800 dark:text-zinc-100">
+            Analisi della marginalità
+          </h1>
+          <p className="mt-[6px] max-w-[620px] text-[13px] text-zinc-400 dark:text-zinc-500">
+            Ricavi (giornate fatturabili × tariffa dell&apos;offerta) confrontati
+            con il costo dei collaboratori (tutte le giornate lavorate, anche non
+            fatturabili, × tariffa del collaboratore). I rimborsi trasferta sono
+            esclusi da entrambi i lati perché passanti. 1 giornata = 8 ore.
+          </p>
+        </div>
+      </div>
+
+      <ReportMarginalita
+        risultato={risultato}
+        meseCorrente={meseCorrente}
+        meseInizioAnno={meseInizioAnno}
+      />
+    </div>
+  );
+}
