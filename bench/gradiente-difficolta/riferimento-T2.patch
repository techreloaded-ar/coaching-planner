+import { describe, it, expect } from "vitest";
+import {
+  calcolaReportMarginalita,
+  validaPeriodoMarginalita,
+  type ImportiMarginalita,
+  type RigaMarginalita,
+} from "@/domain/marginalita";
+import { calcolaReportFatturazioneClienti } from "@/domain/consuntivi";
+
+// ── Helper e dati di esempio ────────────────────────────────────
+
+/** Crea una riga di attività con valori di default sovrascrivibili */
+function riga(modifiche: Partial<RigaMarginalita> = {}): RigaMarginalita {
+  return {
+    mese: "2026-03",
+    clienteId: "cliente-1",
+    clienteRagioneSociale: "Cliente Uno",
+    offertaId: "offerta-1",
+    offertaCodice: "OFF-001",
+    offertaDescrizione: "Sviluppo software",
+    tariffaOffertaGiornaliera: 600,
+    collaboratoreId: "collaboratore-1",
+    collaboratoreNome: "Mario Rossi",
+    tariffaCollaboratoreGiornaliera: 400,
+    ore: 8,
+    fatturabile: true,
+    rimborsoTrasfertaImporto: null,
+    ...modifiche,
+  };
+}
+
+function centesimi(importo: string): number {
+  return Math.round(Number(importo) * 100);
+}
+
+function sommaCentesimi(
+  voci: ImportiMarginalita[],
+  campo: "ricavi" | "costi" | "margine",
+): number {
+  return voci.reduce((somma, voce) => somma + centesimi(voce[campo]), 0);
+}
+
+// ═══════════════════════════════════════════════════════════════
+// calcolaReportMarginalita
+// ═══════════════════════════════════════════════════════════════
+
+describe("calcolaReportMarginalita", () => {
+  it("restituisce un report vuoto con totali a zero e percentuale non definita", () => {
+    const report = calcolaReportMarginalita([]);
+
+    expect(report.perCliente).toEqual([]);
+    expect(report.totali).toEqual({
+      giornateFatturabili: 0,
+      giornateNonFatturabili: 0,
+      ricavi: "0.00",
+      costi: "0.00",
+      margine: "0.00",
+      marginePercentuale: null,
+      rimborsiTrasfertaEsclusi: "0.00",
+    });
+  });
+
+  it("valorizza i ricavi alla tariffa dell'offerta e i costi alla tariffa del collaboratore (8 ore = 1 giornata)", () => {
+    const report = calcolaReportMarginalita([riga({ ore: 8 })]);
+
+    const cliente = report.perCliente[0];
+    expect(cliente.giornateFatturabili).toBe(1);
+    expect(cliente.ricavi).toBe("600.00");
+    expect(cliente.costi).toBe("400.00");
+    expect(cliente.margine).toBe("200.00");
+    expect(cliente.marginePercentuale).toBe("33.3");
+  });
+
+  it("conta le righe non fatturabili come costo senza ricavo", () => {
+    const report = calcolaReportMarginalita([
+      riga({ ore: 8, fatturabile: true }),
+      riga({ ore: 4, fatturabile: false }),
+    ]);
+
+    const cliente = report.perCliente[0];
+    expect(cliente.giornateFatturabili).toBe(1);
+    expect(cliente.giornateNonFatturabili).toBe(0.5);
+    expect(cliente.ricavi).toBe("600.00");
+    // 1,5 giornate lavorate × 400
+    expect(cliente.costi).toBe("600.00");
+    expect(cliente.margine).toBe("0.00");
+    expect(cliente.marginePercentuale).toBe("0.0");
+  });
+
+  it("espone un'offerta con sole ore non fatturabili: margine negativo e percentuale non definita", () => {
+    const report = calcolaReportMarginalita([
+      riga({ ore: 8, fatturabile: false }),
+    ]);
+
+    const offerta = report.perCliente[0].perOfferta[0];
+    expect(offerta.offertaCodice).toBe("OFF-001");
+    expect(offerta.ricavi).toBe("0.00");
+    expect(offerta.costi).toBe("400.00");
+    expect(offerta.margine).toBe("-400.00");
+    expect(offerta.marginePercentuale).toBeNull();
+    expect(report.totali.marginePercentuale).toBeNull();
+  });
+
+  it("calcola margine e percentuale negativi quando i costi superano i ricavi", () => {
+    const report = calcolaReportMarginalita([
+      riga({ tariffaOffertaGiornaliera: 500, tariffaCollaboratoreGiornaliera: 800 }),
+    ]);
+
+    expect(report.totali.margine).toBe("-300.00");
+    expect(report.totali.marginePercentuale).toBe("-60.0");
+  });
+
+  it("esclude i rimborsi trasferta da ricavi e costi, anche su righe non fatturabili, esponendoli a parte", () => {
+    const report = calcolaReportMarginalita([
+      riga({ ore: 8, rimborsoTrasfertaImporto: "35.00" }),
+      riga({ ore: 8, fatturabile: false, rimborsoTrasfertaImporto: "22.50" }),
+    ]);
+
+    const cliente = report.perCliente[0];
+    expect(cliente.ricavi).toBe("600.00");
+    expect(cliente.costi).toBe("800.00");
+    expect(cliente.rimborsiTrasfertaEsclusi).toBe("57.50");
+    expect(report.totali.rimborsiTrasfertaEsclusi).toBe("57.50");
+  });
+
+  it("arrotonda il costo al centesimo una sola volta per collaboratore e offerta", () => {
+    // 1h × 333,33 / 8 = 41,66625 → 41,67; tre righe da 1h → 3h → 124,99875 → 125,00
+    const report = calcolaReportMarginalita([
+      riga({ ore: 1, tariffaCollaboratoreGiornaliera: "333.33" }),
+      riga({ ore: 1, tariffaCollaboratoreGiornaliera: "333.33" }),
+      riga({ ore: 1, tariffaCollaboratoreGiornaliera: "333.33" }),
+    ]);
+
+    expect(report.perCliente[0].costi).toBe("125.00");
+  });
+
+  it("dettaglia per offerta e per collaboratore, con l'aggregato dei collaboratori sul cliente", () => {
+    const report = calcolaReportMarginalita([
+      riga({ offertaId: "o-b", offertaCodice: "OFF-B", collaboratoreId: "c-2", collaboratoreNome: "Zeno Bianchi", tariffaCollaboratoreGiornaliera: 300, ore: 8 }),
+      riga({ offertaId: "o-a", offertaCodice: "OFF-A", collaboratoreId: "c-1", collaboratoreNome: "Anna Verdi", ore: 8 }),
+      riga({ offertaId: "o-b", offertaCodice: "OFF-B", collaboratoreId: "c-1", collaboratoreNome: "Anna Verdi", ore: 4, fatturabile: false }),
+    ]);
+
+    const cliente = report.perCliente[0];
+    expect(cliente.perOfferta.map((o) => o.offertaCodice)).toEqual(["OFF-A", "OFF-B"]);
+
+    const offertaB = cliente.perOfferta[1];
+    expect(offertaB.perCollaboratore.map((c) => c.collaboratoreNome)).toEqual([
+      "Anna Verdi",
+      "Zeno Bianchi",
+    ]);
+    expect(offertaB.perCollaboratore[0]).toMatchObject({
+      tariffaCollaboratoreGiornaliera: "400.00",
+      giornateFatturabili: 0,
+      giornateNonFatturabili: 0.5,
+      ricavi: "0.00",
+      costi: "200.00",
+      margine: "-200.00",
+      marginePercentuale: null,
+    });
+    expect(offertaB.perCollaboratore[1]).toMatchObject({
+      ricavi: "600.00",
+      costi: "300.00",
+      margine: "300.00",
+      marginePercentuale: "50.0",
+    });
+
+    const anna = cliente.perCollaboratore.find((c) => c.collaboratoreId === "c-1");
+    expect(anna).toMatchObject({
+      giornateFatturabili: 1,
+      giornateNonFatturabili: 0.5,
+      ricavi: "600.00",
+      costi: "600.00",
+      margine: "0.00",
+    });
+    expect(cliente.ricavi).toBe("1200.00");
+    expect(cliente.costi).toBe("900.00");
+  });
+
+  it("ordina i clienti per ragione sociale e calcola i totali complessivi", () => {
+    const report = calcolaReportMarginalita([
+      riga({ clienteId: "z", clienteRagioneSociale: "Zeta Srl" }),
+      riga({ clienteId: "a", clienteRagioneSociale: "Alfa Spa", offertaId: "o-2", offertaCodice: "OFF-2" }),
+    ]);
+
+    expect(report.perCliente.map((c) => c.clienteRagioneSociale)).toEqual([
+      "Alfa Spa",
+      "Zeta Srl",
+    ]);
+    expect(report.totali).toMatchObject({
+      giornateFatturabili: 2,
+      ricavi: "1200.00",
+      costi: "800.00",
+      margine: "400.00",
+      marginePercentuale: "33.3",
+    });
+  });
+
+  it("omette i clienti con soli rimborsi e nessuna ora, ma ne conserva i rimborsi nel totale escluso", () => {
+    const report = calcolaReportMarginalita([
+      riga(),
+      riga({ clienteId: "solo-rimborsi", clienteRagioneSociale: "Solo Rimborsi", ore: 0, rimborsoTrasfertaImporto: 40 }),
+    ]);
+
+    expect(report.perCliente.map((c) => c.clienteId)).toEqual(["cliente-1"]);
+    expect(report.totali.rimborsiTrasfertaEsclusi).toBe("40.00");
+  });
+
+  // ── Coerenza con il report Fatturazione Clienti ───────────────
+
+  describe("coerenza con il report Fatturazione Clienti sullo stesso periodo", () => {
+    // Dati con arrotondamenti non banali: tariffe e ore frazionarie,
+    // più collaboratori, offerte, clienti e mesi.
+    const mesi = ["2026-01", "2026-02", "2026-03"];
+    const righe: RigaMarginalita[] = [];
+    let contatore = 0;
+    for (const mese of mesi) {
+      for (const [clienteId, offerte] of [
+        ["cli-a", ["oa-1", "oa-2"]],
+        ["cli-b", ["ob-1"]],
+      ] as const) {
+        for (const offertaId of offerte) {
+          for (const collaboratoreId of ["col-1", "col-2", "col-3"]) {
+            contatore += 1;
+            righe.push(
+              riga({
+                mese,
+                clienteId,
+                clienteRagioneSociale: clienteId === "cli-a" ? "Alfa" : "Beta",
+                offertaId,
+                offertaCodice: offertaId.toUpperCase(),
+                tariffaOffertaGiornaliera: offertaId === "oa-1" ? "333.33" : "517.77",
+                collaboratoreId,
+                collaboratoreNome: collaboratoreId,
+                tariffaCollaboratoreGiornaliera: collaboratoreId === "col-1" ? "251.13" : "199.99",
+                ore: [1.25, 2.5, 3.75, 0.5, 7.25][contatore % 5],
+                fatturabile: contatore % 4 !== 0,
+                rimborsoTrasfertaImporto: contatore % 3 === 0 ? "12.34" : null,
+              }),
+            );
+          }
+        }
+      }
+    }
+
+    const report = calcolaReportMarginalita(righe);
+
+    it("i ricavi di ogni cliente coincidono con la somma degli imponibili manodopera mensili", () => {
+      for (const cliente of report.perCliente) {
+        const attesoCentesimi = mesi.reduce((somma, mese) => {
+          const fatturazione = calcolaReportFatturazioneClienti(
+            righe.filter((r) => r.mese === mese),
+          );
+          const voce = fatturazione.perCliente.find(
+            (c) => c.clienteId === cliente.clienteId,
+          );
+          return somma + (voce ? centesimi(voce.imponibileManodopera) : 0);
+        }, 0);
+        expect(centesimi(cliente.ricavi)).toBe(attesoCentesimi);
+      }
+    });
+
+    it("i rimborsi esclusi coincidono con i rimborsi ribaltati dal report fatturazione", () => {
+      const attesoCentesimi = mesi.reduce(
+        (somma, mese) =>
+          somma +
+          centesimi(
+            calcolaReportFatturazioneClienti(righe.filter((r) => r.mese === mese))
+              .totali.totaleRimborsi,
+          ),
+        0,
+      );
+      expect(centesimi(report.totali.rimborsiTrasfertaEsclusi)).toBe(attesoCentesimi);
+    });
+
+    it("offerte e collaboratori quadrano al centesimo con il cliente, i clienti con il totale", () => {
+      for (const campo of ["ricavi", "costi", "margine"] as const) {
+        for (const cliente of report.perCliente) {
+          expect(sommaCentesimi(cliente.perOfferta, campo)).toBe(centesimi(cliente[campo]));
+          expect(sommaCentesimi(cliente.perCollaboratore, campo)).toBe(centesimi(cliente[campo]));
+          for (const offerta of cliente.perOfferta) {
+            expect(sommaCentesimi(offerta.perCollaboratore, campo)).toBe(centesimi(offerta[campo]));
+          }
+        }
+        expect(sommaCentesimi(report.perCliente, campo)).toBe(centesimi(report.totali[campo]));
+      }
+    });
+  });
+});
+
+// ═══════════════════════════════════════════════════════════════
+// validaPeriodoMarginalita
+// ═══════════════════════════════════════════════════════════════
+
+describe("validaPeriodoMarginalita", () => {
+  it.each([
+    ["2026-01", "2026-03"],
+    ["2026-05", "2026-05"],
+    ["2025-11", "2026-02"],
+  ])("accetta il periodo %s → %s", (meseDa, meseA) => {
+    expect(validaPeriodoMarginalita(meseDa, meseA)).toEqual({
