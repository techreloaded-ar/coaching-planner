+/** Percentuale di margine sui ricavi; "n.d." quando non ci sono ricavi. */
+function formattaPercentuale(percentuale: string | null): string {
+  return percentuale === null
+    ? "n.d."
+    : `${formattatorePercentuale.format(Number(percentuale))}%`;
+}
+
+/** Colore del margine: rosso se negativo, verde se positivo. */
