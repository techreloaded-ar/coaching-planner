+
+  it("calcola ricavi, costi (incluse le ore non fatturabili) e margine escludendo i rimborsi", async () => {
+    mockRigaAttivita.findMany.mockResolvedValue([
+      rigaPrisma({ data: "2026-01-15", ore: "8.00", rimborso: "35.00" }),
+      rigaPrisma({ data: "2026-02-10", ore: "4.00", fatturabile: false }),
+    ]);
+
+    const risultato = await reportMarginalitaPeriodo("2026-01", "2026-02");
+
+    expect(risultato).toMatchObject({
+      meseDa: "2026-01",
+      meseA: "2026-02",
+      errore: null,
+    });
+    const cliente = risultato.perCliente[0];
+    expect(cliente).toMatchObject({
+      clienteRagioneSociale: "Cliente Uno",
+      ricavi: "640.00",
+      costi: "600.00",
+      margine: "40.00",
+      marginePercentuale: "6.3",
+      rimborsiTrasfertaEsclusi: "35.00",
+    });
+    expect(cliente.perCollaboratore[0]).toMatchObject({
+      collaboratoreNome: "Mario Rossi",
+      tariffaCollaboratoreGiornaliera: "400.00",
+    });
+    // Il risultato è interamente serializzabile
+    expect(JSON.parse(JSON.stringify(risultato))).toEqual(risultato);
+  });
+});
