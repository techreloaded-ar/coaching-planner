   return { token, ...report };
 }
+
+// ── Analisi della marginalità ───────────────────────────────────
+
+/**
+ * Risultato serializzabile dell'analisi della marginalità su un periodo.
+ * In caso di periodo non valido `errore` è valorizzato e il report è vuoto.
+ */
+export interface RisultatoReportMarginalita extends ReportMarginalita {
+  /** Token YYYY-MM del primo mese del periodo, come richiesto */
+  meseDa: string;
+  /** Token YYYY-MM dell'ultimo mese del periodo, come richiesto */
+  meseA: string;
+  /** Messaggio di validazione del periodo, `null` se il periodo è valido */
+  errore: string | null;
+}
+
+function reportMarginalitaVuoto(): ReportMarginalita {
+  return {
+    perCliente: [],
+    totali: {
+      giornateFatturabili: 0,
+      giornateNonFatturabili: 0,
+      ricavi: "0.00",
+      costi: "0.00",
+      margine: "0.00",
+      marginePercentuale: null,
+      rimborsiTrasfertaEsclusi: "0.00",
+    },
+  };
+}
+
+/**
+ * Calcola l'analisi della marginalità (ricavi, costi dei collaboratori e
+ * margine) per cliente, offerta e collaboratore su un periodo da mese a mese,
+ * estremi inclusi, aggregando le righe attività di TUTTI i collaboratori.
+ *
+ * Accesso riservato all'amministratore (`richiediRuoloApi("AMMINISTRATORE")`).
+ * Sola lettura: nessuna scrittura sul database.
+ *
+ * L'intervallo di date di ogni mese segue la stessa convenzione di
+ * `reportFatturazioneClientiMese`, e il mese di competenza di ogni riga è
+ * derivato dalla sua data: i ricavi per cliente coincidono quindi con la somma
+ * degli imponibili manodopera del report Fatturazione Clienti sugli stessi mesi.
+ *
+ * @param meseDa - Token YYYY-MM del primo mese
+ * @param meseA - Token YYYY-MM dell'ultimo mese
+ */
+export async function reportMarginalitaPeriodo(
+  meseDa: string,
+  meseA: string,
+): Promise<RisultatoReportMarginalita> {
+  await richiediRuoloApi("AMMINISTRATORE");
+
+  const esito = validaPeriodoMarginalita(meseDa, meseA);
+  if (!esito.valido) {
+    return { meseDa, meseA, errore: esito.errore, ...reportMarginalitaVuoto() };
+  }
+
+  const da = parseTokenMese(esito.periodo.meseDa)!;
+  const a = parseTokenMese(esito.periodo.meseA)!;
+  const inizio = new Date(da.anno, da.mese - 1, 1);
+  const fine = new Date(a.anno, a.mese, 0); // ultimo giorno del mese finale
+
+  const righe = await db.rigaAttivita.findMany({
+    where: {
+      data: {
+        gte: inizio,
+        lte: fine,
+      },
+    },
+    include: {
+      offerta: true,
+      cliente: true,
+      collaboratore: {
+        select: { nome: true, cognome: true, tariffaGiornaliera: true },
+      },
+    },
+    orderBy: { data: "asc" },
+  });
+
+  const righeMappate: RigaMarginalita[] = righe.map((riga) => ({
+    mese: riga.data.toISOString().slice(0, 7),
+    clienteId: riga.clienteId,
+    clienteRagioneSociale: riga.cliente.ragioneSociale,
+    offertaId: riga.offertaId,
+    offertaCodice: riga.offerta.codice,
+    offertaDescrizione: riga.offerta.descrizione,
+    tariffaOffertaGiornaliera: riga.offerta.tariffaGiornaliera.toString(),
+    collaboratoreId: riga.collaboratoreId,
+    collaboratoreNome: `${riga.collaboratore.nome} ${riga.collaboratore.cognome}`,
+    tariffaCollaboratoreGiornaliera:
+      riga.collaboratore.tariffaGiornaliera.toString(),
+    ore: Number(riga.ore),
+    fatturabile: riga.fatturabile,
+    rimborsoTrasfertaImporto: riga.rimborsoTrasfertaImporto?.toString() ?? null,
+  }));
+
+  return {
+    meseDa,
+    meseA,
+    errore: null,
+    ...calcolaReportMarginalita(righeMappate),
+  };
+}
