+        <label className="flex flex-col gap-1 text-[12px] font-semibold text-zinc-500 dark:text-zinc-400">
+          Al mese
+          <input
+            type="month"
+            name="a"
+            defaultValue={meseA}
+            required
+            pattern="\d{4}-\d{2}"
+            placeholder="AAAA-MM"
+            className={classeCampo}
+          />
+        </label>
+        <button
+          type="submit"
+          className="inline-flex cursor-pointer items-center gap-[7px] rounded-[10px] border border-transparent bg-indigo-500 px-[15px] py-[8px] text-[13.5px] font-semibold text-white shadow-sm transition hover:bg-indigo-600"
+        >
+          Aggiorna analisi
+        </button>
+        <div className="flex flex-wrap items-center gap-2">
+          <Link
+            href={`/report/marginalita?da=${meseCorrente}&a=${meseCorrente}`}
+            className={classeScorciatoia}
+          >
+            Mese corrente
+          </Link>
+          <Link
+            href={`/report/marginalita?da=${meseInizioAnno}&a=${meseCorrente}`}
+            className={classeScorciatoia}
+          >
+            Da inizio anno
+          </Link>
+        </div>
+      </Form>
+
+      {errore ? (
+        <div
+          role="alert"
+          className="rounded-[11px] border border-red-200 bg-red-50 px-5 py-4 text-[13.5px] font-semibold text-red-600 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-400"
+        >
+          {errore}
+        </div>
+      ) : vuoto ? (
+        /* ── Stato vuoto ── */
+        <div className="rounded-[11px] border border-zinc-200 bg-white px-6 py-14 text-center shadow-sm dark:border-zinc-700 dark:bg-zinc-800">
+          <h2 className="mb-[7px] text-[16px] font-bold text-zinc-800 dark:text-zinc-100">
+            Nessuna attività nel periodo selezionato
+          </h2>
+          <p className="mx-auto max-w-[420px] text-[13px] leading-relaxed text-zinc-400 dark:text-zinc-500">
+            Non risultano ore registrate dai collaboratori in {periodo}. Scegli
+            un periodo diverso.
