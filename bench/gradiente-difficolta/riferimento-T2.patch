+import type { Page } from "@playwright/test";
+
+import { accediAlBackOfficeComeAdmin, accediComeAdmin, accediComeCollaboratore } from "./support/auth";
+import { dataNelMesePassatoRiservato, mesePassatoRiservato } from "./support/date";
+import { test, expect, type E2eDataFactory } from "./support/fixtures";
+
+/**
+ * Test e2e — Analisi della marginalità per periodo (sola lettura, solo amministratore).
+ *
+ * Il dataset è creato dalla factory su mesi passati riservati: le asserzioni
+ * riguardano solo cliente, offerte e collaboratori del test, mai i totali
+ * globali del periodo, quindi righe estranee negli stessi mesi non interferiscono.
+ */
+
+const CODICE_SPEC_MARGINALITA = "MARGINALITA-REPORT-PERIODO";
+
+const formattatoreEuro = new Intl.NumberFormat("it-IT", {
+	style: "currency",
+	currency: "EUR",
+});
+
+const formattatoreGiornate = new Intl.NumberFormat("it-IT", {
+	minimumFractionDigits: 0,
+	maximumFractionDigits: 2,
+});
+
+const formattatorePercentuale = new Intl.NumberFormat("it-IT", {
+	minimumFractionDigits: 1,
+	maximumFractionDigits: 1,
+});
+
+function euro(valore: number): string {
+	return formattatoreEuro.format(valore);
+}
+
+function giornate(valore: number): string {
+	return formattatoreGiornate.format(valore);
+}
+
+function percentuale(valore: number): string {
+	return `${formattatorePercentuale.format(valore)}%`;
+}
+
+/** Converte un importo formattato it-IT ("1.175,00 €") in centesimi interi. */
+function centesimiDaEuro(testo: string): number {
+	const normalizzato = testo.replace(/[^\d,-]/g, "").replace(",", ".");
+	return Math.round(Number(normalizzato) * 100);
+}
+
+function suffissoDa(namespace: string): string {
+	let hash = 2166136261;
+	for (const carattere of namespace) {
+		hash ^= carattere.charCodeAt(0);
+		hash = Math.imul(hash, 16777619);
+	}
+	return (hash >>> 0).toString(36);
+}
+
+function dataRiservata(giorno: number, mesiIndietro: number): Date {
+	return new Date(
+		`${dataNelMesePassatoRiservato(CODICE_SPEC_MARGINALITA, giorno, mesiIndietro)}T00:00:00.000Z`,
+	);
+}
+
+/**
+ * Dataset su due mesi consecutivi (M1 = 2 mesi indietro, M2 = 1 mese indietro)
+ * più una riga nel mese precedente M1, fuori dal periodo analizzato.
+ *
+ * | Collab. (tariffa) | Offerta (tariffa) | Mese | Ore | Fatt. | Rimborso | Ricavi | Costi |
+ * | A (400)           | O1 (640)          | M1   | 8   | sì    | 35,00    | 640    | 400   |
+ * | A (400)           | O2 (500)          | M1   | 8   | sì    | —        | 500    | 400   |
+ * | B (300)           | O1 (640)          | M2   | 4   | sì    | —        | 320    | 150   |
+ * | B (300)           | O2 (500)          | M2   | 6   | no    | 22,50    | 0      | 225   |
+ * | A (400)           | O1 (640)          | M0   | 8   | sì    | —        | fuori periodo  |
+ */
+async function creaDatasetMarginalita(factory: E2eDataFactory) {
+	const suffisso = suffissoDa(factory.namespace);
+	const cliente = await factory.createCliente({
+		ragioneSociale: `E2E Marginalità ${suffisso}`,
+	});
+	const offertaUno = await factory.createOfferta({
+		cliente,
+		codice: `MRG1-${suffisso}`,
+		descrizione: `Coaching team ${suffisso}`,
+		tariffaGiornaliera: "640.00",
+	});
+	const offertaDue = await factory.createOfferta({
+		cliente,
+		codice: `MRG2-${suffisso}`,
+		descrizione: `Formazione ${suffisso}`,
+		tariffaGiornaliera: "500.00",
+	});
+	const collaboratoreA = await factory.createCollaboratore({
+		nome: "E2E Margine",
+		cognome: `Alfa ${suffisso}`,
+		tariffaGiornaliera: "400.00",
+	});
+	const collaboratoreB = await factory.createCollaboratore({
+		nome: "E2E Margine",
+		cognome: `Beta ${suffisso}`,
+		tariffaGiornaliera: "300.00",
+	});
+
+	await factory.createRigaAttivita({
+		collaboratore: collaboratoreA,
+		cliente,
+		offerta: offertaUno,
+		data: dataRiservata(4, 2),
+		ore: "8.00",
+		fatturabile: true,
+		rimborsoTrasfertaEtichetta: `Trasferta ${suffisso}`,
+		rimborsoTrasfertaImporto: "35.00",
+	});
+	await factory.createRigaAttivita({
+		collaboratore: collaboratoreA,
+		cliente,
+		offerta: offertaDue,
+		data: dataRiservata(20, 2),
+		ore: "8.00",
+		fatturabile: true,
+	});
+	await factory.createRigaAttivita({
+		collaboratore: collaboratoreB,
+		cliente,
+		offerta: offertaUno,
+		data: dataRiservata(11, 1),
+		ore: "4.00",
+		fatturabile: true,
+	});
+	await factory.createRigaAttivita({
+		collaboratore: collaboratoreB,
+		cliente,
+		offerta: offertaDue,
+		data: dataRiservata(18, 1),
+		ore: "6.00",
+		fatturabile: false,
+		rimborsoTrasfertaEtichetta: `Trasferta non fatturabile ${suffisso}`,
+		rimborsoTrasfertaImporto: "22.50",
+	});
+	// Fuori periodo: non deve contribuire all'analisi
+	await factory.createRigaAttivita({
+		collaboratore: collaboratoreA,
+		cliente,
+		offerta: offertaUno,
+		data: dataRiservata(9, 3),
+		ore: "8.00",
+		fatturabile: true,
+	});
+
+	return {
+		cliente,
+		offertaUno,
+		offertaDue,
+		nomeCollaboratoreA: `E2E Margine Alfa ${suffisso}`,
+		nomeCollaboratoreB: `E2E Margine Beta ${suffisso}`,
+		meseDa: mesePassatoRiservato(CODICE_SPEC_MARGINALITA, 2),
+		meseA: mesePassatoRiservato(CODICE_SPEC_MARGINALITA, 1),
+	};
+}
+
+type DatasetMarginalita = Awaited<ReturnType<typeof creaDatasetMarginalita>>;
+
+function rigaTabella(page: Page, nomeTabella: string, testoRiga: string) {
+	return page
+		.getByRole("table", { name: nomeTabella, exact: true })
+		.getByRole("row")
+		.filter({ has: page.getByText(testoRiga, { exact: true }) });
+}
+
+async function verificaCelle(
+	page: Page,
+	nomeTabella: string,
+	testoRiga: string,
+	valoriAttesi: string[],
+): Promise<void> {
+	const riga = rigaTabella(page, nomeTabella, testoRiga);
+	await expect(riga).toHaveCount(1);
+	await expect(riga.getByRole("cell")).toHaveText(valoriAttesi);
+}
+
+async function verificaAnalisiCliente(
+	page: Page,
+	dataset: DatasetMarginalita,
+): Promise<void> {
+	const { cliente, offertaUno, offertaDue } = dataset;
+	const prefisso = `marginalita-cliente-${cliente.id}`;
+
+	await expect(
+		page.getByRole("heading", { name: cliente.ragioneSociale, exact: true }),
+	).toBeVisible();
+
+	// Cliente: ricavi 1460, costi 1175, margine 285 (19,5%); rimborsi esclusi 57,50
+	await expect(page.getByTestId(`${prefisso}-ricavi`)).toHaveText(euro(1460));
+	await expect(page.getByTestId(`${prefisso}-costi`)).toHaveText(euro(1175));
+	await expect(page.getByTestId(`${prefisso}-margine`)).toHaveText(euro(285));
+	await expect(page.getByTestId(`${prefisso}-percentuale`)).toHaveText(percentuale(19.5));
+	await expect(page.getByTestId(`${prefisso}-rimborsi-esclusi`)).toHaveText(euro(57.5));
+
+	// Per offerta: tariffa, gg fatturabili, gg non fatturabili, ricavi, costi, margine, %
+	const tabellaOfferte = `Offerte ${cliente.ragioneSociale}`;
+	await verificaCelle(page, tabellaOfferte, offertaUno.codice, [
+		euro(640),
+		giornate(1.5),
+		giornate(0),
+		euro(960),
+		euro(550),
+		euro(410),
+		percentuale(42.7),
+	]);
+	await verificaCelle(page, tabellaOfferte, offertaDue.codice, [
+		euro(500),
+		giornate(1),
+		giornate(0.75),
+		euro(500),
+		euro(625),
+		euro(-125),
+		percentuale(-25),
+	]);
+}
+
+test.describe("Analisi della marginalità", () => {
+	test("l'amministratore sceglie il periodo dal form e vede ricavi, costi e margine per cliente e offerta", async ({
+		page,
+		factory,
+	}) => {
+		const dataset = await creaDatasetMarginalita(factory);
+
+		await accediComeAdmin(page);
+		await page.goto("/report/marginalita");
+		await expect(
+			page.getByRole("heading", { name: "Analisi della marginalità", exact: true }),
+		).toBeVisible();
+
+		await page.getByLabel("Dal mese", { exact: true }).fill(dataset.meseDa);
+		await page.getByLabel("Al mese", { exact: true }).fill(dataset.meseA);
+		await page.getByRole("button", { name: "Aggiorna analisi", exact: true }).click();
+		await page.waitForURL(
+			(url) =>
+				url.pathname === "/report/marginalita" &&
+				url.searchParams.get("da") === dataset.meseDa &&
+				url.searchParams.get("a") === dataset.meseA,
+		);
+
+		await verificaAnalisiCliente(page, dataset);
+	});
+
+	test("il dettaglio per collaboratore include le ore non fatturabili come costo senza ricavo", async ({
+		page,
+		factory,
+	}) => {
+		const dataset = await creaDatasetMarginalita(factory);
+		const { cliente, offertaDue } = dataset;
+
+		await accediComeAdmin(page);
+		await page.goto(`/report/marginalita?da=${dataset.meseDa}&a=${dataset.meseA}`);
+
+		// <details> nativo: l'espansione non dipende dall'idratazione
+		await page
+			.getByText(`Dettaglio collaboratori ${cliente.ragioneSociale}`, { exact: true })
+			.click();
+
+		// Complessivo sul cliente: tariffa, gg fatt., gg non fatt., ricavi, costi, margine, %
+		const tabellaCliente = `Collaboratori ${cliente.ragioneSociale}`;
+		await verificaCelle(page, tabellaCliente, dataset.nomeCollaboratoreA, [
+			euro(400),
+			giornate(2),
+			giornate(0),
+			euro(1140),
+			euro(800),
+			euro(340),
+			percentuale(29.8),
+		]);
+		await verificaCelle(page, tabellaCliente, dataset.nomeCollaboratoreB, [
+			euro(300),
+			giornate(0.5),
+			giornate(0.75),
+			euro(320),
+			euro(375),
+			euro(-55),
+			percentuale(-17.2),
+		]);
+
+		// Su un'offerta: B ha solo ore non fatturabili → margine negativo, % non definita
+		await verificaCelle(
+			page,
+			`Collaboratori offerta ${offertaDue.codice}`,
+			dataset.nomeCollaboratoreB,
+			[euro(300), giornate(0), giornate(0.75), euro(0), euro(225), euro(-225), "n.d."],
+		);
+	});
+
+	test("i ricavi coincidono con il report Fatturazione Clienti degli stessi mesi al netto dei rimborsi", async ({
+		page,
+		factory,
+	}) => {
+		const dataset = await creaDatasetMarginalita(factory);
+		const { cliente } = dataset;
+
+		await accediComeAdmin(page);
+
+		let imponibileFatturazioneCentesimi = 0;
+		for (const mese of [dataset.meseDa, dataset.meseA]) {
+			await page.goto(`/report/fatturazione-clienti?mese=${mese}`);
+			const totale = await page
+				.getByTestId(`report-client-${cliente.id}-totale`)
+				.textContent();
+			const rimborsi = await page
+				.getByTestId(`report-client-${cliente.id}-rimborsi`)
+				.textContent();
+			imponibileFatturazioneCentesimi +=
+				centesimiDaEuro(totale ?? "") - centesimiDaEuro(rimborsi ?? "");
+		}
+		expect(imponibileFatturazioneCentesimi).toBe(146000);
+
+		await page.goto(`/report/marginalita?da=${dataset.meseDa}&a=${dataset.meseA}`);
+		await expect(
+			page.getByTestId(`marginalita-cliente-${cliente.id}-ricavi`),
+		).toHaveText(euro(imponibileFatturazioneCentesimi / 100));
+	});
+
+	test("un periodo con mese iniziale successivo al finale mostra un errore di validazione", async ({
+		page,
+	}) => {
+		const meseDa = mesePassatoRiservato(CODICE_SPEC_MARGINALITA, 1);
+		const meseA = mesePassatoRiservato(CODICE_SPEC_MARGINALITA, 2);
+
+		await accediComeAdmin(page);
+		await page.goto(`/report/marginalita?da=${meseDa}&a=${meseA}`);
+
+		await expect(
+			page.getByRole("alert").filter({
+				hasText: "Il mese iniziale non può essere successivo al mese finale.",
+			}),
+		).toBeVisible();
+		await expect(
+			page.getByRole("table", { name: /^Offerte / }),
+		).toHaveCount(0);
+	});
+
+	test("la voce Marginalità della console apre il report", async ({ page }) => {
+		await accediAlBackOfficeComeAdmin(page);
+
+		await page.getByRole("link", { name: "Marginalità", exact: true }).click();
+		await page.waitForURL("**/report/marginalita**");
+		await expect(
+			page.getByRole("heading", { name: "Analisi della marginalità", exact: true }),
+		).toBeVisible();
+	});
+
+	test("un collaboratore non può accedere all'analisi della marginalità", async ({
+		page,
+		collaboratore,
+	}) => {
+		await accediComeCollaboratore(page, collaboratore.utente.email);
+
+		await page.goto("/report/marginalita");
+
+		await page.waitForURL("**/attivita**");
+		await expect(
+			page.getByRole("heading", { name: "Analisi della marginalità" }),
+		).toHaveCount(0);
+	});
+});
