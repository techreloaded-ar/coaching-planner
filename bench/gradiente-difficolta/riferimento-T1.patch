+
+  it.each(["+39 02 1234567", "02-1234567", "(011) 765.4321", "3331234567", "+44 20 7946 0958"])(
+    "accetta il telefono %s",
+    (telefono) => {
+      const errori = validaCliente(
+        baseInput({ referenteNome: "Marta", referenteTelefono: telefono })
+      );
+      expect(errori.referenteTelefono).toBeUndefined();
+    }
+  );
+
+  it.each(["abc", "12345", "+39 02 abc", "02 1234567 int. 3", "1234567890123456", "++39021234567"])(
+    "rifiuta il telefono %s",
+    (telefono) => {
+      const errori = validaCliente(
+        baseInput({ referenteNome: "Marta", referenteTelefono: telefono })
+      );
+      expect(errori.referenteTelefono).toBe(
+        "Inserisci un numero di telefono valido (es. +39 02 1234567)"
+      );
+    }
+  );
+});