diff --git a/src/domain/anagrafiche/referente-cliente.ts b/src/domain/anagrafiche/referente-cliente.ts
new file mode 100644
index 0000000..0d994f4
--- /dev/null
+++ b/src/domain/anagrafiche/referente-cliente.ts
@@ -0,0 +1,45 @@
+// Referente del cliente: persona di contatto presso il cliente (ADR-006)
+// Nessuna dipendenza da framework — funzioni pure.
+
+/** Referente del cliente pronto per la visualizzazione (serializzabile). */
+export interface ReferenteCliente {
+  nome: string | null;
+  email: string | null;
+  telefono: string | null;
+}
+
+/** Campi referente così come persistiti su `Cliente` (tutti facoltativi). */
+export interface CampiReferenteCliente {
+  referenteNome: string | null;
+  referenteEmail: string | null;
+  referenteTelefono: string | null;
+}
+
+/**
+ * Ricava il referente dai campi del cliente.
+ *
+ * Nome, email e telefono sono indipendenti: basta uno di essi per avere un
+ * referente. Restituisce `null` quando sono tutti assenti, come per i clienti
+ * creati prima dell'introduzione del referente, che restano validi.
+ */
+export function referenteDelCliente(
+  cliente: CampiReferenteCliente,
+): ReferenteCliente | null {
+  const nome = cliente.referenteNome?.trim() || null;
+  const email = cliente.referenteEmail?.trim() || null;
+  const telefono = cliente.referenteTelefono?.trim() || null;
+
+  if (nome === null && email === null && telefono === null) {
+    return null;
+  }
+
+  return { nome, email, telefono };
+}
+
+/**
+ * Costruisce l'href `tel:` di un numero, mantenendo solo "+" iniziale e cifre.
+ */
+export function hrefTelefono(telefono: string): string {
+  const prefissoInternazionale = telefono.trim().startsWith("+") ? "+" : "";
+  return `tel:${prefissoInternazionale}${telefono.replace(/\D/g, "")}`;
+}
