+  // --- Referente (nome, email e telefono facoltativi e indipendenti) ---
+
+  const referenteNome = dati.referenteNome?.trim() ?? "";
+  const referenteEmail = dati.referenteEmail?.trim() ?? "";
+  const referenteTelefono = dati.referenteTelefono?.trim() ?? "";
+
+  if (referenteNome.length > MAX_LUNGHEZZA_NOME_REFERENTE) {
+    errori.referenteNome = `Il nome del referente può contenere al massimo ${MAX_LUNGHEZZA_NOME_REFERENTE} caratteri`;
