+/**
+ * Un telefono è valido se usa solo cifre e separatori comuni (spazi, punti,
+ * trattini, barre, parentesi), con "+" facoltativo in testa, e contiene da
+ * 6 a 15 cifre (limite E.164).
+ */
+function telefonoValido(telefono: string): boolean {
+  if (!RE_TELEFONO.test(telefono)) {
+    return false;
+  }
+  const numeroCifre = telefono.replace(/\D/g, "").length;
