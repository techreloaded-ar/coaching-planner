diff --git a/tests/unit/referente-cliente.test.ts b/tests/unit/referente-cliente.test.ts
new file mode 100644
index 0000000..ea7baa5
--- /dev/null
+++ b/tests/unit/referente-cliente.test.ts
@@ -0,0 +1,71 @@
+import { describe, it, expect } from "vitest";
+import {
+  hrefTelefono,
+  referenteDelCliente,
+} from "@/domain/anagrafiche/referente-cliente";
+
+describe("referenteDelCliente", () => {
+  it("restituisce null per un cliente senza referente", () => {
+    expect(
+      referenteDelCliente({
+        referenteNome: null,
+        referenteEmail: null,
+        referenteTelefono: null,
+      })
+    ).toBeNull();
+  });
+
+  it("restituisce null se tutti i campi sono vuoti o di soli spazi", () => {
+    expect(
+      referenteDelCliente({
+        referenteNome: "   ",
+        referenteEmail: "",
+        referenteTelefono: " ",
+      })
+    ).toBeNull();
+  });
+
+  it("restituisce il referente con la sola email, senza nome", () => {
+    expect(
+      referenteDelCliente({
+        referenteNome: "   ",
+        referenteEmail: "marta@cliente.it",
+        referenteTelefono: null,
+      })
+    ).toEqual({ nome: null, email: "marta@cliente.it", telefono: null });
+  });
+
+  it("restituisce il referente con il solo telefono, senza nome", () => {
+    expect(
+      referenteDelCliente({
+        referenteNome: null,
+        referenteEmail: null,
+        referenteTelefono: " 02 1234567 ",
+      })
+    ).toEqual({ nome: null, email: null, telefono: "02 1234567" });
+  });
+
+  it("restituisce nome e recapiti normalizzati", () => {
+    expect(
+      referenteDelCliente({
+        referenteNome: " Marta Bianchi ",
+        referenteEmail: "marta@cliente.it",
+        referenteTelefono: "",
+      })
+    ).toEqual({
+      nome: "Marta Bianchi",
+      email: "marta@cliente.it",
+      telefono: null,
+    });
+  });
+});
+
+describe("hrefTelefono", () => {
+  it("mantiene il prefisso internazionale e le sole cifre", () => {
+    expect(hrefTelefono("+39 02 1234567")).toBe("tel:+39021234567");
+  });
+
+  it("rimuove separatori e parentesi da un numero nazionale", () => {
+    expect(hrefTelefono("(011) 765.43-21")).toBe("tel:0117654321");
+  });
+});
