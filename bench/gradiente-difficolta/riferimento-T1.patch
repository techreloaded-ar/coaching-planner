+/** Telefono: "+" iniziale facoltativo, poi cifre e separatori comuni */
+const RE_TELEFONO = /^\+?[0-9(][0-9 ./()-]*$/;
+const MIN_CIFRE_TELEFONO = 6;
+const MAX_CIFRE_TELEFONO = 15;
+const MAX_LUNGHEZZA_NOME_REFERENTE = 120;
 const RE_EMAIL =
   /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
 
