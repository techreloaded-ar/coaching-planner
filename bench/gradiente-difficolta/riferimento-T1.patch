@@ -507,3 +507,57 @@ describe("calcolaReportFatturazioneClienti", () => {
     });
   });
 });
+
+// ═══════════════════════════════════════════════════════════════
+// Referente del cliente nel report
+// ═══════════════════════════════════════════════════════════════
+
+describe("calcolaReportFatturazioneClienti — referente del cliente", () => {
+  const referente = {
+    nome: "Marta Bianchi",
+    email: "marta@cliente.it",
+    telefono: "+39 02 1234567",
+  };
+
+  it("riporta il referente del cliente nella voce cliente", () => {
+    const report = calcolaReportFatturazioneClienti([
+      riga({ clienteReferente: referente }),
+    ]);
+
+    expect(report.perCliente[0].clienteReferente).toEqual(referente);
+  });
+
+  it("usa null per i clienti senza referente (campo assente o null)", () => {
+    const report = calcolaReportFatturazioneClienti([
+      riga({ clienteId: "cliente-a", clienteRagioneSociale: "Alfa" }),
+      riga({
+        clienteId: "cliente-b",
+        clienteRagioneSociale: "Beta",
+        clienteReferente: null,
+      }),
+    ]);
+
+    expect(report.perCliente.map((c) => c.clienteReferente)).toEqual([null, null]);
+  });
+
+  it("non altera importi e totali", () => {
+    const righe = [
+      riga({ ore: 8, tariffaOffertaGiornaliera: 500, rimborsoTrasfertaImporto: "35.00" }),
+      riga({ ore: 4, tariffaOffertaGiornaliera: 500 }),
+    ];
+
+    const senzaReferente = calcolaReportFatturazioneClienti(righe);
+    const conReferente = calcolaReportFatturazioneClienti(
+      righe.map((r) => ({ ...r, clienteReferente: referente })),
+    );
+
+    expect(conReferente.totali).toEqual(senzaReferente.totali);
+    expect(conReferente.totali.importoTotale).toBe("785.00");
+    const { clienteReferente, ...restoConReferente } = conReferente.perCliente[0];
+    const { clienteReferente: nessuno, ...restoSenzaReferente } =
+      senzaReferente.perCliente[0];
+    expect(clienteReferente).toEqual(referente);
+    expect(nessuno).toBeNull();
+    expect(restoConReferente).toEqual(restoSenzaReferente);
+  });
+});
diff --git a/tests/unit/report-fatturazione-referente.test.ts b/tests/unit/report-fatturazione-referente.test.ts
new file mode 100644
index 0000000..5c57775
--- /dev/null
+++ b/tests/unit/report-fatturazione-referente.test.ts
@@ -0,0 +1,117 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+// ── Mock di Prisma e del DAL ─────────────────────────────────────
+
+const { mockRigaAttivita } = vi.hoisted(() => ({
+  mockRigaAttivita: { findMany: vi.fn() },
+}));
+
+vi.mock("@/lib/db", () => ({
+  db: { rigaAttivita: mockRigaAttivita },
+}));
+
+const { mockRichiediRuoloApi } = vi.hoisted(() => ({
+  mockRichiediRuoloApi: vi.fn(),
+}));
+
+vi.mock("@/lib/dal", () => ({
+  richiediRuoloApi: mockRichiediRuoloApi,
+}));
+
+import { reportFatturazioneClientiMese } from "@/lib/report";
+
+// ── Builder di supporto ─────────────────────────────────────────
+
+function rigaDb(cliente: {
+  id: string;
+  ragioneSociale: string;
+  referenteNome: string | null;
+  referenteEmail: string | null;
+  referenteTelefono: string | null;
+}) {
+  return {
+    id: `riga-${cliente.id}`,
+    collaboratoreId: "collab-1",
+    clienteId: cliente.id,
+    offertaId: `off-${cliente.id}`,
+    data: new Date(2026, 4, 12),
+    ore: { toString: () => "8", valueOf: () => 8 },
+    nota: null,
+    fatturabile: true,
+    rimborsoTrasfertaEtichetta: null,
+    rimborsoTrasfertaImporto: null,
+    offerta: {
+      id: `off-${cliente.id}`,
+      codice: `OFF-${cliente.id}`,
+      descrizione: "Consulenza",
+      tariffaGiornaliera: { toString: () => "500.00" },
+    },
+    cliente: { attivo: true, ...cliente },
+    collaboratore: { nome: "Ada", cognome: "Lovelace" },
+  };
+}
+
+describe("reportFatturazioneClientiMese — referente del cliente", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockRichiediRuoloApi.mockResolvedValue(undefined);
+  });
+
+  it("espone il referente nell'intestazione cliente, anche parziale, e null se assente", async () => {
+    mockRigaAttivita.findMany.mockResolvedValue([
+      rigaDb({
+        id: "a",
+        ragioneSociale: "Alfa SPA",
+        referenteNome: "Marta Bianchi",
+        referenteEmail: "marta@alfa.it",
+        referenteTelefono: null,
+      }),
+      rigaDb({
+        id: "b",
+        ragioneSociale: "Beta SRL",
+        referenteNome: null,
+        referenteEmail: null,
+        referenteTelefono: null,
+      }),
+      rigaDb({
+        id: "c",
+        ragioneSociale: "Gamma SNC",
+        referenteNome: null,
+        referenteEmail: "ufficio@gamma.it",
+        referenteTelefono: null,
+      }),
+      rigaDb({
+        id: "d",
+        ragioneSociale: "Omega SAS",
+        referenteNome: "",
+        referenteEmail: null,
+        referenteTelefono: "02 1234567",
+      }),
+    ]);
+
+    const report = await reportFatturazioneClientiMese("2026-05");
+
+    expect(mockRichiediRuoloApi).toHaveBeenCalledWith("AMMINISTRATORE");
+    expect(report.perCliente.map((c) => c.clienteReferente)).toEqual([
+      { nome: "Marta Bianchi", email: "marta@alfa.it", telefono: null },
+      null,
+      { nome: null, email: "ufficio@gamma.it", telefono: null },
+      { nome: null, email: null, telefono: "02 1234567" },
+    ]);
+    expect(report.perCliente.map((c) => c.importoTotale)).toEqual([
+      "500.00",
+      "500.00",
+      "500.00",
+      "500.00",
+    ]);
+  });
+
+  it("non legge dati se l'utente non è amministratore", async () => {
+    mockRichiediRuoloApi.mockRejectedValue(new Error("Accesso negato"));
+
+    await expect(reportFatturazioneClientiMese("2026-05")).rejects.toThrow(
+      "Accesso negato",
+    );
+    expect(mockRigaAttivita.findMany).not.toHaveBeenCalled();
+  });
+});
