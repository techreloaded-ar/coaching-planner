+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+const { mockRigaAttivita } = vi.hoisted(() => ({
+  mockRigaAttivita: { findMany: vi.fn() },
+}));
+
+vi.mock("@/lib/db", () => ({
+  db: { rigaAttivita: mockRigaAttivita },
+}));
+
+const { mockRichiediRuoloApi } = vi.hoisted(() => ({
+  mockRichiediRuoloApi: vi.fn(),
+}));
+
+vi.mock("@/lib/dal", () => ({
+  richiediRuoloApi: mockRichiediRuoloApi,
+}));
+
+import { reportFatturazioneClientiMese } from "@/lib/report";
+
+// ── Helper ──────────────────────────────────────────────────────
+
+const STORICO_OFFERTA = [
+  {
+    id: "t-origine",
+    validaDal: new Date("1900-01-01T00:00:00.000Z"),
+    tariffaGiornaliera: { toString: () => "550.00" },
+    updatedAt: new Date("2026-01-01T00:00:00.000Z"),
+  },
+  {
+    id: "t-2027",
+    validaDal: new Date("2027-01-01T00:00:00.000Z"),
+    tariffaGiornaliera: { toString: () => "600.00" },
+    updatedAt: new Date("2026-01-01T00:00:00.000Z"),
+  },
+];
+
+function rigaDb(dataIso: string, ore: number) {
+  return {
+    id: `riga-${dataIso}`,
+    collaboratoreId: "collab-1",
+    clienteId: "cli-1",
+    offertaId: "off-1",
+    data: new Date(`${dataIso}T00:00:00.000Z`),
+    ore: { toString: () => String(ore) },
+    nota: null,
+    fatturabile: true,
+    rimborsoTrasfertaEtichetta: null,
+    rimborsoTrasfertaImporto: null,
+    offerta: {
+      id: "off-1",
+      codice: "OFF-001",
+      descrizione: "Coaching",
+      clienteId: "cli-1",
+      tariffe: STORICO_OFFERTA,
+    },
+    cliente: { id: "cli-1", ragioneSociale: "Cliente Uno" },
+    collaboratore: { nome: "Giulia", cognome: "Conti" },
+  };
+}
+
+describe("reportFatturazioneClientiMese — tariffa dell'offerta alla data della riga", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockRichiediRuoloApi.mockResolvedValue(undefined);
+  });
+
+  it("include lo storico tariffe dell'offerta nella lettura delle righe", async () => {
+    mockRigaAttivita.findMany.mockResolvedValue([]);
+
+    await reportFatturazioneClientiMese("2026-12");
+
+    expect(mockRichiediRuoloApi).toHaveBeenCalledWith("AMMINISTRATORE");
+    expect(mockRigaAttivita.findMany.mock.calls[0][0].include.offerta).toEqual({
+      include: {
+        tariffe: {
+          select: { id: true, validaDal: true, tariffaGiornaliera: true, updatedAt: true },
+          orderBy: { validaDal: "asc" },
+        },
+      },
+    });
+  });
+
+  it("un mese passato resta valorizzato con la tariffa di allora anche se ne è prevista una nuova", async () => {
+    mockRigaAttivita.findMany.mockResolvedValue([rigaDb("2026-12-31", 8)]);
+
+    const report = await reportFatturazioneClientiMese("2026-12");
+
+    const [offerta] = report.perCliente[0].perOfferta;
+    expect(offerta.tariffaGiornaliera).toBe("550.00");
+    expect(report.totali.imponibileManodopera).toBe("550.00");
+  });
+
+  it("dal giorno di inizio validità usa la nuova tariffa", async () => {
+    mockRigaAttivita.findMany.mockResolvedValue([rigaDb("2027-01-01", 8), rigaDb("2027-01-02", 4)]);
+
+    const report = await reportFatturazioneClientiMese("2027-01");
+
+    expect(report.perCliente[0].perOfferta[0].tariffaGiornaliera).toBe("600.00");
+    expect(report.totali.imponibileManodopera).toBe("900.00");
+  });
+
+  it("non legge le righe senza ruolo amministratore", async () => {
+    mockRichiediRuoloApi.mockRejectedValue(new Error("Accesso negato"));
+
+    await expect(reportFatturazioneClientiMese("2027-01")).rejects.toThrow("Accesso negato");
+    expect(mockRigaAttivita.findMany).not.toHaveBeenCalled();
+  });
+});
