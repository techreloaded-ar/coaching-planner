+    ).toBe("La prima tariffa vale dall'origine: la data non è modificabile");
+  });
+
+  it("sposta la data di una validità futura restando nel futuro e dopo la precedente", () => {
+    expect(
+      validaCorrezioneUltimaValidita(
+        storicoConFutura,
+        { validaDal: "2027-02-01", tariffaGiornaliera: "650,00" },
+        OGGI,
+      ),
+    ).toEqual({});
+    expect(
+      validaCorrezioneUltimaValidita(
+        storicoConFutura,
+        { validaDal: "2026-10-01", tariffaGiornaliera: "650,00" },
+        OGGI,
+      ).validaDal,
+    ).toMatch(/non può essere nel passato/);
+  });
+
+  it("non sovrappone l'ultima validità alla precedente", () => {
+    const storico = [
+      validita("v-origine", DATA_ORIGINE_VALIDITA, "550.00"),
+      validita("v-a", "2026-11-01", "600.00"),
+      validita("v-b", "2027-01-01", "650.00"),
+    ];
+    expect(
+      validaCorrezioneUltimaValidita(
+        storico,
+        { validaDal: "2026-11-01", tariffaGiornaliera: "650,00" },
+        OGGI,
+      ).validaDal,
+    ).toBe(
+      "La data di inizio deve essere successiva al 01/11/2026, inizio della tariffa precedente",
+    );
+  });
+
+  it("rifiuta un importo non valido", () => {
+    expect(
+      validaCorrezioneUltimaValidita(
+        STORICO_CON_CAMBIO,
+        { validaDal: "2026-01-01", tariffaGiornaliera: "abc" },
+        OGGI,
+      ).tariffaGiornaliera,
+    ).toBe("Importo non valido: usa massimo 2 decimali");
+  });
+});
+
+describe("validaEliminazioneUltimaValidita", () => {
+  it("ammette l'eliminazione di una validità non ancora iniziata", () => {
+    expect(
+      validaEliminazioneUltimaValidita(
+        [...STORICO_CON_CAMBIO, validita("v-2027", "2027-01-01", "650.00")],
+        OGGI,
+      ),
+    ).toBeNull();
+  });
+
+  it("vieta l'eliminazione di una validità già in vigore", () => {
+    expect(validaEliminazioneUltimaValidita(STORICO_CON_CAMBIO, OGGI)).toMatch(
+      /già in vigore/,
+    );
+  });
+
+  it("vieta l'eliminazione della validità d'origine", () => {
+    expect(
+      validaEliminazioneUltimaValidita([validita("v", DATA_ORIGINE_VALIDITA, "550.00")], OGGI),
+    ).toBe("La prima tariffa non può essere eliminata");
+  });
+});
