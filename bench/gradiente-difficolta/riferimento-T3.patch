@@ -0,0 +1,286 @@
+import type { Locator, Page } from "@playwright/test";
+
+import { accediComeAdmin, accediComeCollaboratore } from "./support/auth";
+import { dataNelMesePassatoRiservato, mesePassatoRiservato } from "./support/date";
+import { test, expect } from "./support/fixtures";
+
+/**
+ * Test e2e — Tariffe con validità nel tempo.
+ *
+ * Le tariffe giornaliere di offerta (prezzo al cliente) e collaboratore
+ * (compenso) hanno una data di inizio validità. Una nuova tariffa inserita in
+ * anticipo vale dalla sua data: i conti dei mesi già trascorsi restano quelli
+ * calcolati con la tariffa di allora.
+ *
+ * Isolamento: ogni scenario crea offerta, cliente e collaboratore propri con la
+ * factory e asserisce solo sulle proprie entità (scheda cliente nel report,
+ * riepilogo del proprio collaboratore). Il mese passato è riservato; il mese
+ * futuro è quello in cui entra in vigore la nuova tariffa (gennaio dell'anno
+ * prossimo) e non viene mai asserito a livello di totali globali.
+ */
+
+const CODICE_SPEC_TARIFFE = "TARIFFE-VALIDITA-NEL-TEMPO";
+
+const ANNO_PROSSIMO = new Date().getFullYear() + 1;
+const INIZIO_NUOVA_TARIFFA = `${ANNO_PROSSIMO}-01-01`;
+const ULTIMO_GIORNO_VECCHIA_TARIFFA = `31/12/${ANNO_PROSSIMO - 1}`;
+const MESE_NUOVA_TARIFFA = `${ANNO_PROSSIMO}-01`;
+
+const formattatoreEuro = new Intl.NumberFormat("it-IT", {
+	style: "currency",
+	currency: "EUR",
+});
+
+function formattaEuro(valore: string | number): string {
+	return formattatoreEuro.format(Number(valore));
+}
+
+function dataColonna(dataIso: string): Date {
+	return new Date(`${dataIso}T00:00:00.000Z`);
+}
+
+function tabellaStorico(page: Page): Locator {
+	return page.getByRole("table", { name: "Storico tariffe", exact: true });
+}
+
+function righeStorico(page: Page): Locator {
+	return tabellaStorico(page).getByRole("row").filter({
+		hasNot: page.getByRole("columnheader"),
+	});
+}
+
+async function inserisciNuovaTariffa(
+	page: Page,
+	validaDal: string,
+	importo: string,
+): Promise<Locator> {
+	const form = page.getByRole("form", { name: "Nuova tariffa" });
+	await form.getByLabel("Data inizio nuova tariffa", { exact: true }).fill(validaDal);
+	await form.getByLabel("Importo nuova tariffa", { exact: true }).fill(importo);
+	await form.getByRole("button", { name: "Aggiungi tariffa" }).click();
+	return form;
+}
+
+test.describe("Tariffe con validità nel tempo", () => {
+	test("una nuova tariffa offerta vale dalla sua data e non cambia il report dei mesi passati", async ({
+		page,
+		factory,
+	}) => {
+		const meseTrascorso = mesePassatoRiservato(CODICE_SPEC_TARIFFE);
+		const { cliente, offerta } = await factory.createClienteConOfferta(
+			{},
+			{ tariffaGiornaliera: "550.00" },
+		);
+		const { collaboratore } = await factory.createCollaboratore();
+		await factory.createRigaAttivita({
+			collaboratore,
+			offerta,
+			data: dataColonna(dataNelMesePassatoRiservato(CODICE_SPEC_TARIFFE, 10)),
+			ore: "8.00",
+		});
+		await factory.createRigaAttivita({
+			collaboratore,
+			offerta,
+			data: dataColonna(`${MESE_NUOVA_TARIFFA}-15`),
+			ore: "8.00",
+		});
+
+		await accediComeAdmin(page);
+		await page.goto(`/report/fatturazione-clienti?mese=${meseTrascorso}`);
+		const totaleClientePrima = page.getByTestId(`report-client-${cliente.id}-totale`);
+		await expect(totaleClientePrima).toHaveText(formattaEuro(550));
+
+		// Inserimento anticipato della tariffa del nuovo anno
+		await page.goto(`/offerte/${offerta.id}`);
+		const form = await inserisciNuovaTariffa(page, INIZIO_NUOVA_TARIFFA, "600,00");
+		await expect(form.getByRole("status")).toHaveText("Nuova tariffa registrata");
+
+		await expect(righeStorico(page)).toHaveCount(2);
+		await expect(righeStorico(page).nth(0).getByRole("cell")).toHaveText([
+			"Dall'origine",
+			ULTIMO_GIORNO_VECCHIA_TARIFFA,
+			formattaEuro(550),
+			"Vigente",
+		]);
+		await expect(righeStorico(page).nth(1).getByRole("cell")).toHaveText([
+			`01/01/${ANNO_PROSSIMO}`,
+			"In corso",
+			formattaEuro(600),
+			"Futura",
+		]);
+		// Oggi vale ancora la tariffa precedente
+		await expect(
+			page.getByLabel("Tariffa giornaliera vigente", { exact: true }),
+		).toHaveValue("550,00");
+
+		// Il mese trascorso resta invariato…
+		await page.goto(`/report/fatturazione-clienti?mese=${meseTrascorso}`);
+		await expect(page.getByTestId(`report-client-${cliente.id}-totale`)).toHaveText(
+			formattaEuro(550),
+		);
+
+		// …mentre il mese della nuova validità usa la nuova tariffa.
+		await page.goto(`/report/fatturazione-clienti?mese=${MESE_NUOVA_TARIFFA}`);
+		await expect(page.getByTestId(`report-client-${cliente.id}-totale`)).toHaveText(
+			formattaEuro(600),
+		);
+		const rigaOfferta = page.getByRole("row").filter({
+			has: page.getByText(offerta.codice, { exact: true }),
+		});
+		await expect(rigaOfferta.getByRole("cell").nth(1)).toHaveText(formattaEuro(600));
+	});
+
+	test("una nuova tariffa collaboratore non cambia il riepilogo dei mesi passati", async ({
+		page,
+		browser,
+		factory,
+	}) => {
+		const meseTrascorso = mesePassatoRiservato(CODICE_SPEC_TARIFFE, 2);
+		const collaboratore = await factory.createCollaboratore({ tariffaGiornaliera: "350.00" });
+		const offerta = await factory.createOfferta();
+		await factory.createRigaAttivita({
+			collaboratore,
+			offerta,
+			data: dataColonna(dataNelMesePassatoRiservato(CODICE_SPEC_TARIFFE, 12, 2)),
+			ore: "8.00",
+		});
+		await factory.createRigaAttivita({
+			collaboratore,
+			offerta,
+			data: dataColonna(`${MESE_NUOVA_TARIFFA}-20`),
+			ore: "8.00",
+		});
+
+		await accediComeAdmin(page);
+		await page.goto(`/anagrafiche/collaboratori/${collaboratore.collaboratore.id}/modifica`);
+		const form = await inserisciNuovaTariffa(page, INIZIO_NUOVA_TARIFFA, "400");
+		await expect(form.getByRole("status")).toHaveText("Nuova tariffa registrata");
+		await expect(righeStorico(page)).toHaveCount(2);
+
+		// L'elenco collaboratori mostra la tariffa vigente oggi
+		await page.goto("/anagrafiche/collaboratori");
+		const rigaElenco = page
+			.getByRole("table", { name: "Elenco collaboratori" })
+			.getByRole("row")
+			.filter({ hasText: collaboratore.collaboratore.cognome });
+		await expect(rigaElenco).toContainText(formattaEuro(350));
+
+		const contestoCollaboratore = await browser.newContext();
+		const paginaCollaboratore = await contestoCollaboratore.newPage();
+		try {
+			await accediComeCollaboratore(paginaCollaboratore, collaboratore.utente.email);
+
+			await paginaCollaboratore.goto(`/attivita/riepilogo?mese=${meseTrascorso}`);
+			await expect(
+				paginaCollaboratore.getByTestId("summary-importo-fattura-value"),
+			).toHaveText(/€\s*350,00/);
+
+			await paginaCollaboratore.goto(`/attivita/riepilogo?mese=${MESE_NUOVA_TARIFFA}`);
+			await expect(
+				paginaCollaboratore.getByTestId("summary-importo-fattura-value"),
+			).toHaveText(/€\s*400,00/);
