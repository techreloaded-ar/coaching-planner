+"use client";
+
+import { useActionState } from "react";
+import { PulsanteAttesa, useValoriInviati } from "@/components";
+import { formattaEuro } from "@/lib/formattazione";
+import {
+  formattaDataValidita,
+  type PeriodoValiditaTariffa,
+  type StatoValiditaTariffa,
+} from "@/domain/tariffe";
+import type { StoricoTariffe as DatiStoricoTariffe } from "@/lib/tariffe";
+import {
+  correggiUltimaValiditaTariffaAction,
+  eliminaUltimaValiditaTariffaAction,
+  inserisciValiditaTariffaAction,
+  type EsitoActionTariffe,
+  type StatoActionTariffe,
+} from "./actions";
+
+// ── Props ──────────────────────────────────────────────────────
+
+interface StoricoTariffeProps {
+  storico: DatiStoricoTariffe;
+  /** Cosa rappresenta la tariffa, es. "prezzo giornaliero al cliente" */
+  descrizioneTariffa: string;
+}
+
+const statoIniziale: StatoActionTariffe = { errori: {} };
+
+const ETICHETTA_STATO: Record<StatoValiditaTariffa, string> = {
+  STORICA: "Storica",
+  VIGENTE: "Vigente",
+  FUTURA: "Futura",
+};
+
+const CLASSI_STATO: Record<StatoValiditaTariffa, string> = {
+  STORICA:
+    "border border-zinc-200 bg-zinc-100 text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400",
+  VIGENTE: "bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400",
+  FUTURA: "bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400",
+};
+
+const MESSAGGIO_ESITO: Record<EsitoActionTariffe, string> = {
+  inserita: "Nuova tariffa registrata",
+  corretta: "Ultima tariffa corretta",
+  eliminata: "Ultima tariffa eliminata",
+};
+
+function etichettaDal(periodo: PeriodoValiditaTariffa): string {
+  return periodo.origine ? "Dall'origine" : formattaDataValidita(periodo.validaDal);
+}
+
+function etichettaAl(periodo: PeriodoValiditaTariffa): string {
+  return periodo.validaAl === null ? "In corso" : formattaDataValidita(periodo.validaAl);
+}
+
+/** Importo normalizzato "550.00" → "550,00" per i campi di input. */
+function importoPerInput(importo: string): string {
+  return importo.replace(".", ",");
+}
+
+// ── Componente ─────────────────────────────────────────────────
+
+/**
+ * Pannello back-office dello storico tariffe di un'offerta o di un
+ * collaboratore: elenco delle validità, inserimento di una nuova tariffa con
+ * data di inizio, correzione dell'ultima ed eliminazione dell'ultima se non è
+ * ancora iniziata. Ogni form rimanda la versione dello storico letta in
+ * pagina: una modifica concorrente nel frattempo viene rifiutata.
+ */
+export default function StoricoTariffe({ storico, descrizioneTariffa }: StoricoTariffeProps) {
+  const ultima = storico.periodi.at(-1);
+  const ultimaEliminabile =
+    !!ultima && !ultima.origine && ultima.validaDal >= storico.oggi;
+  const dataUltimaModificabile =
+    !!ultima && !ultima.origine && ultima.validaDal >= storico.oggi;
+
+  return (
+    <section
+      aria-labelledby="titolo-storico-tariffe"
+      className="mt-[22px] max-w-[760px] rounded-[11px] border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900"
+    >
+      <div className="border-b border-zinc-200 px-7 py-[18px] dark:border-zinc-800">
+        <h2
+          id="titolo-storico-tariffe"
+          className="text-[15px] font-bold tracking-tight text-zinc-800 dark:text-zinc-100"
+        >
+          Tariffe nel tempo
+        </h2>
+        <p className="mt-1 text-[12.5px] text-zinc-400 dark:text-zinc-500">
+          Tariffa giornaliera ({descrizioneTariffa}) con data di inizio validità. Ogni
+          riga attività è valorizzata con la tariffa vigente alla sua data: una nuova
+          tariffa non cambia i conti dei giorni già trascorsi.
+        </p>
+      </div>
+
+      <div className="overflow-x-auto">
+        <table className="w-full border-collapse text-[13.5px]" aria-label="Storico tariffe">
+          <thead>
+            <tr>
+              <th className="px-7 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[.06em] text-zinc-400 dark:text-zinc-500">
+                Dal
+              </th>
+              <th className="px-4 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[.06em] text-zinc-400 dark:text-zinc-500">
+                Al
+              </th>
+              <th className="px-4 py-[11px] text-right text-[11px] font-semibold uppercase tracking-[.06em] text-zinc-400 dark:text-zinc-500">
+                Tariffa
+              </th>
+              <th className="px-7 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[.06em] text-zinc-400 dark:text-zinc-500">
+                Stato
+              </th>
+            </tr>
+          </thead>
+          <tbody>
+            {storico.periodi.map((periodo) => (
+              <tr key={periodo.id} className="border-t border-zinc-100 dark:border-zinc-800/60">
+                <td className="px-7 py-[11px] font-semibold tabular-nums text-zinc-800 dark:text-zinc-100">
+                  {etichettaDal(periodo)}
+                </td>
+                <td className="px-4 py-[11px] tabular-nums text-zinc-500 dark:text-zinc-400">
+                  {etichettaAl(periodo)}
+                </td>
+                <td className="px-4 py-[11px] text-right font-semibold tabular-nums text-zinc-800 dark:text-zinc-100">
+                  {formattaEuro(periodo.tariffaGiornaliera)}
+                </td>
+                <td className="px-7 py-[11px]">
+                  <span
+                    className={`inline-flex items-center rounded-full px-[9px] py-[3px] text-[11.5px] font-semibold whitespace-nowrap ${CLASSI_STATO[periodo.stato]}`}
+                  >
+                    {ETICHETTA_STATO[periodo.stato]}
+                  </span>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+
+      <FormNuovaTariffa storico={storico} />
+
+      {ultima && (
+        <FormCorrezioneUltimaTariffa
+          storico={storico}
+          ultima={ultima}
+          dataModificabile={dataUltimaModificabile}
+        />
+      )}
+
+      {ultimaEliminabile && <FormEliminazioneUltimaTariffa storico={storico} />}
+    </section>
+  );
+}
+
+// ── Form ───────────────────────────────────────────────────────
+
+function CampiRiferimento({ storico }: { storico: DatiStoricoTariffe }) {
+  return (
+    <>
+      <input type="hidden" name="tipoEntita" value={storico.tipoEntita} />
+      <input type="hidden" name="entitaId" value={storico.entitaId} />
+      <input type="hidden" name="versione" value={storico.versione} />
+    </>
+  );
+}
+
+function EsitoForm({ stato }: { stato: StatoActionTariffe }) {
+  if (stato.errori._form) {
+    return (
+      <p
+        role="alert"
+        className="mb-[14px] rounded-[11px] border border-red-200 bg-red-50 px-[13px] py-[11px] text-[13px] font-semibold text-red-600 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-400"
+      >
+        {stato.errori._form}
+      </p>
+    );
+  }
+  if (stato.esito) {
+    return (
+      <p
+        role="status"
+        className="mb-[14px] rounded-[11px] border border-emerald-200 bg-emerald-50 px-[13px] py-[11px] text-[13px] font-semibold text-emerald-700 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-400"
+      >
+        {MESSAGGIO_ESITO[stato.esito]}
+      </p>
+    );
+  }
+  return null;
+}
+
+function FormNuovaTariffa({ storico }: { storico: DatiStoricoTariffe }) {
+  const [stato, azione] = useActionState(inserisciValiditaTariffaAction, statoIniziale);
+  const { azioneConMemoria, valoreIniziale } = useValoriInviati(azione);
+  const haErrori = Object.keys(stato.errori).length > 0;
+  // Dopo un salvataggio riuscito il form torna vuoto; dopo un errore conserva
+  // quanto inviato.
+  const valore = (campo: string) => (haErrori ? valoreIniziale(campo, "") : "");
+
+  return (
+    <form
+      noValidate
+      action={azioneConMemoria}
+      aria-label="Nuova tariffa"
+      className="border-t border-zinc-200 px-7 py-[18px] dark:border-zinc-800"
+    >
+      <CampiRiferimento storico={storico} />
+      <h3 className="mb-3 text-[13px] font-bold text-zinc-700 dark:text-zinc-200">
+        Nuova tariffa
+      </h3>
+      <EsitoForm stato={stato} />
+      <div className="grid grid-cols-2 gap-x-[18px] max-[920px]:grid-cols-1">
+        <Campo
+          id={`nuova-validita-dal-${storico.entitaId}`}
+          label="Data inizio nuova tariffa"
+          name="validaDal"
+          type="date"
+          min={storico.oggi}
+          defaultValue={valore("validaDal")}
+          errore={stato.errori.validaDal}
+          hint="Da oggi in poi: la tariffa precedente vale fino al giorno prima"
+        />
+        <Campo
+          id={`nuova-validita-importo-${storico.entitaId}`}
+          label="Importo nuova tariffa"
+          name="tariffaGiornaliera"
+          placeholder="Es. 650,00"
+          inputMode="decimal"
+          defaultValue={valore("tariffaGiornaliera")}
+          errore={stato.errori.tariffaGiornaliera}
+          suffisso="€"
+        />
+      </div>
+      <div className="flex justify-end">
+        <PulsanteAttesa
+          etichettaAttesa="Salvataggio…"
+          className="inline-flex items-center gap-[7px] rounded-[10px] border border-transparent bg-indigo-500 px-[15px] py-[9px] font-[inherit] text-[13.5px] font-semibold text-white shadow-sm transition hover:bg-indigo-600"
+        >
+          Aggiungi tariffa
+        </PulsanteAttesa>
+      </div>
+    </form>
+  );
+}
+
+function FormCorrezioneUltimaTariffa({
+  storico,
+  ultima,
+  dataModificabile,
+}: {
+  storico: DatiStoricoTariffe;
+  ultima: PeriodoValiditaTariffa;
+  dataModificabile: boolean;
+}) {
+  const [stato, azione] = useActionState(correggiUltimaValiditaTariffaAction, statoIniziale);
+  const { azioneConMemoria, valoreIniziale } = useValoriInviati(azione);
+  const haErrori = Object.keys(stato.errori).length > 0;
+  const valore = (campo: string, originale: string) =>
+    haErrori ? valoreIniziale(campo, originale) : originale;
+  const giaInVigore = ultima.validaDal < storico.oggi;
+
+  return (
+    <form
+      noValidate
+      action={azioneConMemoria}
+      aria-label="Correggi ultima tariffa"
+      className="border-t border-zinc-200 px-7 py-[18px] dark:border-zinc-800"
+    >
+      <CampiRiferimento storico={storico} />
+      <h3 className="mb-3 text-[13px] font-bold text-zinc-700 dark:text-zinc-200">
+        Correggi ultima tariffa
+      </h3>
+      <EsitoForm stato={stato} />
+      {giaInVigore && (
+        <p className="mb-[14px] text-[12.5px] text-amber-700 dark:text-amber-400">
+          Questa tariffa è già in vigore: correggendo l&apos;importo cambiano anche i conti
+          dei giorni già trascorsi da quando vale. Per un cambio di tariffa usa
+          &quot;Nuova tariffa&quot;.
+        </p>
+      )}
+      <div className="grid grid-cols-2 gap-x-[18px] max-[920px]:grid-cols-1">
+        {dataModificabile ? (
+          <Campo
+            id={`ultima-validita-dal-${storico.entitaId}`}
+            label="Data inizio ultima tariffa"
+            name="validaDal"
+            type="date"
+            min={storico.oggi}
+            defaultValue={valore("validaDal", ultima.validaDal)}
+            errore={stato.errori.validaDal}
+          />
+        ) : (
+          <>
+            <input type="hidden" name="validaDal" value={ultima.validaDal} />
+            <Campo
+              id={`ultima-validita-dal-${storico.entitaId}`}
+              label="Data inizio ultima tariffa"
+              type="text"
+              defaultValue={etichettaDal(ultima)}
+              errore={stato.errori.validaDal}
+              soloLettura
+              hint={
+                ultima.origine
+                  ? "La prima tariffa vale dall'origine"
+                  : "Già in vigore: la data non è modificabile"
+              }
+            />
+          </>
+        )}
+        <Campo
+          id={`ultima-validita-importo-${storico.entitaId}`}
+          label="Importo ultima tariffa"
+          name="tariffaGiornaliera"
+          inputMode="decimal"
+          defaultValue={valore("tariffaGiornaliera", importoPerInput(ultima.tariffaGiornaliera))}
+          errore={stato.errori.tariffaGiornaliera}
+          suffisso="€"
+        />
+      </div>
+      <div className="flex justify-end">
+        <PulsanteAttesa
+          etichettaAttesa="Salvataggio…"
+          className="inline-flex items-center gap-[7px] rounded-[10px] border border-zinc-200 bg-white px-[15px] py-[9px] font-[inherit] text-[13.5px] font-semibold text-zinc-700 shadow-sm transition hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200"
+        >
+          Salva correzione
+        </PulsanteAttesa>
+      </div>
+    </form>
+  );
+}
+
+function FormEliminazioneUltimaTariffa({ storico }: { storico: DatiStoricoTariffe }) {
+  const [stato, azione] = useActionState(eliminaUltimaValiditaTariffaAction, statoIniziale);
+
+  return (
+    <form
+      action={azione}
+      aria-label="Elimina ultima tariffa"
+      className="flex flex-wrap items-center justify-between gap-3 rounded-b-[11px] border-t border-zinc-200 bg-zinc-50 px-7 py-4 dark:border-zinc-700 dark:bg-zinc-800/50"
+    >
+      <CampiRiferimento storico={storico} />
+      <div className="min-w-0 flex-1">
+        <EsitoForm stato={stato} />
+        <span className="text-[12.5px] text-zinc-500 dark:text-zinc-400">
+          L&apos;ultima tariffa non è ancora iniziata: puoi eliminarla, la precedente torna
+          valida senza scadenza.
+        </span>
+      </div>
+      <PulsanteAttesa
+        etichettaAttesa="Eliminazione…"
+        className="inline-flex items-center gap-[7px] rounded-[10px] border border-red-200 bg-white px-[15px] py-[9px] font-[inherit] text-[13.5px] font-semibold text-red-600 shadow-sm transition hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400"
+      >
+        Elimina ultima tariffa
+      </PulsanteAttesa>
+    </form>
+  );
+}
+
+// ── Campo ──────────────────────────────────────────────────────
+
+interface CampoProps {
+  id: string;
+  label: string;
+  name?: string;
+  type?: string;
+  placeholder?: string;
+  inputMode?: "decimal" | "text";
+  min?: string;
+  defaultValue?: string;
+  errore?: string;
+  suffisso?: string;
+  hint?: string;
+  /** Campo in sola lettura: non modificabile e non inviato nel FormData */
+  soloLettura?: boolean;
+}
+
+function Campo({
+  id,
+  label,
+  name,
+  type = "text",
+  placeholder,
+  inputMode,
+  min,
+  defaultValue,
+  errore,
+  suffisso,
+  hint,
+  soloLettura,
+}: CampoProps) {
+  return (
+    <div className="mb-[14px] flex min-w-0 flex-col gap-[6px] text-left">
+      <label
+        htmlFor={id}
+        className="text-[12.5px] font-semibold tracking-[.01em] text-zinc-600 dark:text-zinc-400"
+      >
+        {label}
+      </label>
+      <div className="relative">
+        <input
+          id={id}
+          name={soloLettura ? undefined : name}
+          type={type}
+          placeholder={placeholder}
+          inputMode={inputMode}
+          min={min}
+          defaultValue={defaultValue}
+          readOnly={soloLettura}
+          aria-invalid={errore ? true : undefined}
+          className={`w-full rounded-[10px] border px-[13px] py-[10px] font-[inherit] text-[14px] outline-none transition placeholder:text-zinc-400 ${
+            suffisso ? "pr-11" : ""
+          } ${
+            soloLettura
+              ? "cursor-default border-zinc-200 bg-zinc-50 text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800/50 dark:text-zinc-400"
+              : `bg-white text-zinc-800 dark:bg-zinc-900 dark:text-zinc-100 ${
+                  errore
+                    ? "border-red-600 shadow-[0_0_0_3px_rgb(239_68_68_/_0.08)]"
+                    : "border-zinc-200 focus:border-indigo-300 focus:shadow-[0_0_0_3px_rgb(99_102_241_/_0.12)] dark:border-zinc-700"
+                }`
+          }`}
+        />
+        {suffisso && (
+          <span className="pointer-events-none absolute right-[13px] top-1/2 -translate-y-1/2 text-[13px] font-semibold text-zinc-400 dark:text-zinc-500">
+            {suffisso}
+          </span>
+        )}
+      </div>
+      {errore && (
+        <p className="m-0 text-[12px] font-semibold text-red-600 dark:text-red-400">{errore}</p>
+      )}
+      {!errore && hint && (
+        <span className="text-[11.5px] text-zinc-400 dark:text-zinc-500">{hint}</span>
+      )}
+    </div>
+  );
+}
