+-- Tariffe con validità nel tempo.
+--
+-- Le tariffe giornaliere di Offerta (prezzo al cliente) e Collaboratore
+-- (compenso) passano da una colonna singola a uno storico di validità: ogni
+-- riga apre una validità da `validaDal`, che si chiude il giorno prima della
+-- validità successiva; l'ultima resta aperta.
+--
+-- Backfill: la tariffa attuale di ogni entità diventa un'unica validità aperta
+-- dalla data d'origine 1900-01-01. Ogni riga attività esistente, a qualunque
+-- data, ricade quindi in quella validità e viene valorizzata con lo stesso
+-- importo di prima: i report dei mesi passati restano invariati. Le righe
+-- attività non vengono toccate.
+
+-- CreateTable
+CREATE TABLE "TariffaCollaboratore" (
+    "id" TEXT NOT NULL,
+    "collaboratoreId" TEXT NOT NULL,
+    "validaDal" DATE NOT NULL,
+    "tariffaGiornaliera" DECIMAL(10,2) NOT NULL,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "TariffaCollaboratore_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateTable
+CREATE TABLE "TariffaOfferta" (
+    "id" TEXT NOT NULL,
+    "offertaId" TEXT NOT NULL,
+    "validaDal" DATE NOT NULL,
+    "tariffaGiornaliera" DECIMAL(10,2) NOT NULL,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "TariffaOfferta_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE UNIQUE INDEX "TariffaCollaboratore_collaboratoreId_validaDal_key" ON "TariffaCollaboratore"("collaboratoreId", "validaDal");
+
+-- CreateIndex
+CREATE UNIQUE INDEX "TariffaOfferta_offertaId_validaDal_key" ON "TariffaOfferta"("offertaId", "validaDal");
+
+-- AddForeignKey
+ALTER TABLE "TariffaCollaboratore" ADD CONSTRAINT "TariffaCollaboratore_collaboratoreId_fkey" FOREIGN KEY ("collaboratoreId") REFERENCES "Collaboratore"("id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "TariffaOfferta" ADD CONSTRAINT "TariffaOfferta_offertaId_fkey" FOREIGN KEY ("offertaId") REFERENCES "Offerta"("id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- Backfill: tariffa attuale → validità aperta dalla data d'origine
+INSERT INTO "TariffaOfferta" ("id", "offertaId", "validaDal", "tariffaGiornaliera", "createdAt", "updatedAt")
+SELECT gen_random_uuid()::text, "id", DATE '1900-01-01', "tariffaGiornaliera", CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
+FROM "Offerta";
+
+INSERT INTO "TariffaCollaboratore" ("id", "collaboratoreId", "validaDal", "tariffaGiornaliera", "createdAt", "updatedAt")
+SELECT gen_random_uuid()::text, "id", DATE '1900-01-01', "tariffaGiornaliera", CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
+FROM "Collaboratore";
+
+-- Verifica del backfill prima di eliminare la colonna sorgente: ogni entità
+-- deve avere esattamente la propria validità d'origine con lo stesso importo.
+-- In caso contrario la migrazione fallisce e la transazione viene annullata.
+DO $$
+DECLARE
+    offerte_non_allineate INTEGER;
+    collaboratori_non_allineati INTEGER;
+BEGIN
+    SELECT COUNT(*) INTO offerte_non_allineate
+    FROM "Offerta" o
+    WHERE (
+        SELECT COUNT(*) FROM "TariffaOfferta" t
+        WHERE t."offertaId" = o."id"
+          AND t."validaDal" = DATE '1900-01-01'
+          AND t."tariffaGiornaliera" = o."tariffaGiornaliera"
+    ) <> 1;
+
+    SELECT COUNT(*) INTO collaboratori_non_allineati
+    FROM "Collaboratore" c
+    WHERE (
+        SELECT COUNT(*) FROM "TariffaCollaboratore" t
+        WHERE t."collaboratoreId" = c."id"
+          AND t."validaDal" = DATE '1900-01-01'
+          AND t."tariffaGiornaliera" = c."tariffaGiornaliera"
+    ) <> 1;
+
+    IF offerte_non_allineate > 0 OR collaboratori_non_allineati > 0 THEN
+        RAISE EXCEPTION 'Backfill tariffe non allineato: % offerte, % collaboratori',
+            offerte_non_allineate, collaboratori_non_allineati;
+    END IF;
+END $$;
+
+-- AlterTable
+ALTER TABLE "Collaboratore" DROP COLUMN "tariffaGiornaliera";
+
+-- AlterTable
+ALTER TABLE "Offerta" DROP COLUMN "tariffaGiornaliera";
