+"use server";
+
+import { revalidatePath } from "next/cache";
+import { richiediRuoloApi } from "@/lib/dal";
+import {
+  correggiUltimaValiditaTariffa,
+  eliminaUltimaValiditaTariffa,
+  inserisciValiditaTariffa,
+  type EsitoModificaStoricoTariffe,
+  type TipoEntitaTariffa,
+} from "@/lib/tariffe";
+import type { ErroriValiditaTariffa } from "@/domain/tariffe";
+
+// ── Tipi per useActionState ─────────────────────────────────────
+
+export type EsitoActionTariffe = "inserita" | "corretta" | "eliminata";
+
+export interface StatoActionTariffe {
+  errori: ErroriValiditaTariffa;
+  esito?: EsitoActionTariffe;
+}
+
+// ── Helpers ─────────────────────────────────────────────────────
+
+interface RiferimentoStorico {
+  tipoEntita: TipoEntitaTariffa;
+  entitaId: string;
+  versione: string;
+}
+
+function riferimentoDaForm(formData: FormData): RiferimentoStorico | null {
+  const tipoEntita = formData.get("tipoEntita");
+  const entitaId = formData.get("entitaId");
+  const versione = formData.get("versione");
+
+  if (
+    (tipoEntita !== "OFFERTA" && tipoEntita !== "COLLABORATORE") ||
+    typeof entitaId !== "string" ||
+    entitaId === "" ||
+    typeof versione !== "string"
+  ) {
+    return null;
+  }
+
+  return { tipoEntita, entitaId, versione };
+}
+
+function datiValiditaDaForm(formData: FormData) {
+  return {
+    validaDal: ((formData.get("validaDal") as string) ?? "").trim(),
+    tariffaGiornaliera: ((formData.get("tariffaGiornaliera") as string) ?? "").trim(),
+  };
+}
+
+/**
+ * Una tariffa cambia i consuntivi di anagrafiche, offerte, report e riepilogo
+ * collaboratore: si invalidano tutte le sezioni che ne mostrano gli importi.
+ */
+function rivalidaSezioniConImporti(): void {
+  revalidatePath("/anagrafiche", "layout");
+  revalidatePath("/offerte", "layout");
+  revalidatePath("/report", "layout");
+  revalidatePath("/attivita", "layout");
+}
+
+function statoDaEsito(
+  esito: EsitoModificaStoricoTariffe,
+  esitoAction: EsitoActionTariffe,
+): StatoActionTariffe {
+  // Si rivalida anche in caso di errore: se lo storico è cambiato per
+  // un'operazione concorrente, la pagina mostra subito la versione aggiornata
+  // (con il nuovo token di versione) e l'amministratore può riprovare.
+  rivalidaSezioniConImporti();
+  if (esito.esito === "ERRORI") {
+    return { errori: esito.errori };
+  }
+  return { errori: {}, esito: esitoAction };
+}
+
+const ERRORE_RIFERIMENTO: StatoActionTariffe = {
+  errori: { _form: "Riferimento allo storico tariffe mancante o non valido" },
+};
+
+// ── Server Actions (solo amministratore) ────────────────────────
+
+/** Inserisce una nuova validità (tariffa futura) in coda allo storico. */
+export async function inserisciValiditaTariffaAction(
+  _prevState: StatoActionTariffe,
+  formData: FormData,
+): Promise<StatoActionTariffe> {
+  await richiediRuoloApi("AMMINISTRATORE");
+
+  const riferimento = riferimentoDaForm(formData);
+  if (!riferimento) {
+    return ERRORE_RIFERIMENTO;
+  }
+
+  const esito = await inserisciValiditaTariffa(
+    riferimento.tipoEntita,
+    riferimento.entitaId,
+    riferimento.versione,
+    datiValiditaDaForm(formData),
+  );
+  return statoDaEsito(esito, "inserita");
+}
+
+/** Corregge importo e, se ammesso, data di inizio dell'ultima validità. */
+export async function correggiUltimaValiditaTariffaAction(
+  _prevState: StatoActionTariffe,
+  formData: FormData,
+): Promise<StatoActionTariffe> {
+  await richiediRuoloApi("AMMINISTRATORE");
+
+  const riferimento = riferimentoDaForm(formData);
+  if (!riferimento) {
+    return ERRORE_RIFERIMENTO;
+  }
+
+  const esito = await correggiUltimaValiditaTariffa(
+    riferimento.tipoEntita,
+    riferimento.entitaId,
+    riferimento.versione,
+    datiValiditaDaForm(formData),
+  );
+  return statoDaEsito(esito, "corretta");
+}
+
+/** Elimina l'ultima validità se non è ancora iniziata. */
+export async function eliminaUltimaValiditaTariffaAction(
+  _prevState: StatoActionTariffe,
+  formData: FormData,
+): Promise<StatoActionTariffe> {
+  await richiediRuoloApi("AMMINISTRATORE");
+
+  const riferimento = riferimentoDaForm(formData);
+  if (!riferimento) {
+    return ERRORE_RIFERIMENTO;
+  }
+
+  const esito = await eliminaUltimaValiditaTariffa(
+    riferimento.tipoEntita,
+    riferimento.entitaId,
+    riferimento.versione,
+  );
+  return statoDaEsito(esito, "eliminata");
+}
