+
+// ── Helper ──────────────────────────────────────────────────────
+
+const OGGI = "2026-10-22";
+
+function validita(id: string, validaDal: string, tariffaGiornaliera: string): ValiditaTariffa {
+  return { id, validaDal, tariffaGiornaliera };
+}
+
+/** Storico tipico: tariffa d'origine 550, nuova tariffa 600 dal 1° gennaio 2026. */
+const STORICO_CON_CAMBIO = [
+  validita("v-origine", DATA_ORIGINE_VALIDITA, "550.00"),
+  validita("v-2026", "2026-01-01", "600.00"),
+];
+
+// ═══════════════════════════════════════════════════════════════
+// Date
+// ═══════════════════════════════════════════════════════════════
+
+describe("date di validità", () => {
+  it("riconosce solo date di calendario esistenti in formato YYYY-MM-DD", () => {
+    expect(eDataIsoValida("2026-02-28")).toBe(true);
+    expect(eDataIsoValida("2028-02-29")).toBe(true);
+    expect(eDataIsoValida("2026-02-29")).toBe(false);
+    expect(eDataIsoValida("2026-13-01")).toBe(false);
+    expect(eDataIsoValida("01/01/2026")).toBe(false);
+    expect(eDataIsoValida("")).toBe(false);
+  });
+
+  it("calcola il giorno precedente attraverso mesi e anni", () => {
+    expect(giornoPrecedente("2026-01-01")).toBe("2025-12-31");
+    expect(giornoPrecedente("2028-03-01")).toBe("2028-02-29");
+    expect(giornoPrecedente("2026-07-15")).toBe("2026-07-14");
+  });
+});
+
+// ═══════════════════════════════════════════════════════════════
+// Tariffa vigente
+// ═══════════════════════════════════════════════════════════════
+
+describe("tariffaVigenteAl", () => {
+  it("usa la tariffa con l'inizio più recente non successivo alla data", () => {
+    expect(tariffaVigenteAl(STORICO_CON_CAMBIO, "2025-12-31")).toBe("550.00");
+    expect(tariffaVigenteAl(STORICO_CON_CAMBIO, "2026-01-01")).toBe("600.00");
+    expect(tariffaVigenteAl(STORICO_CON_CAMBIO, "2030-06-15")).toBe("600.00");
+  });
+
+  it("la validità d'origine copre qualunque data storica", () => {
+    expect(tariffaVigenteAl(STORICO_CON_CAMBIO, "1999-03-10")).toBe("550.00");
+  });
+
+  it("non dipende dall'ordine dello storico", () => {
+    const disordinato = [...STORICO_CON_CAMBIO].reverse();
+    expect(tariffaVigenteAl(disordinato, "2025-12-31")).toBe("550.00");
+    expect(tariffaVigenteAl(disordinato, "2026-01-02")).toBe("600.00");
+  });
+
+  it("restituisce null se nessuna validità copre la data", () => {
+    expect(tariffaVigenteAl([validita("v", "2026-01-01", "600.00")], "2025-12-31")).toBeNull();
