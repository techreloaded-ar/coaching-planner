new file mode 100644
index 0000000..4256d7a
--- /dev/null
+++ b/src/lib/tariffe.ts
@@ -0,0 +1,386 @@
+import "server-only";
+
+import { Prisma } from "@/generated/prisma/client";
+import { db } from "@/lib/db";
+import { richiediRuoloApi } from "@/lib/dal";
+import { normalizzaTariffaGiornaliera } from "@/domain/anagrafiche/valida-collaboratore";
+import {
+  DATA_ORIGINE_VALIDITA,
+  ordinaValidita,
+  periodiValidita,
+  tariffaVigenteAl,
+  validaCorrezioneUltimaValidita,
+  validaEliminazioneUltimaValidita,
+  validaNuovaValidita,
+  versioneStorico,
+  type DatiValiditaTariffaInput,
+  type ErroriValiditaTariffa,
+  type PeriodoValiditaTariffa,
+  type ValiditaTariffa,
+} from "@/domain/tariffe";
+
+// ── Tipi ────────────────────────────────────────────────────────
+
+/** Entità che possiede uno storico di tariffe giornaliere. */
+export type TipoEntitaTariffa = "OFFERTA" | "COLLABORATORE";
+
+/** Riga di storico come letta da Prisma (TariffaOfferta o TariffaCollaboratore). */
+export interface RigaStoricoTariffaDb {
+  id: string;
+  validaDal: Date;
+  tariffaGiornaliera: { toString(): string };
+  updatedAt: Date;
+}
+
+/** Storico tariffe serializzabile per il back-office. */
+export interface StoricoTariffe {
+  tipoEntita: TipoEntitaTariffa;
+  entitaId: string;
+  /** Periodi in ordine cronologico, con data di fine e stato derivati */
+  periodi: PeriodoValiditaTariffa[];
+  /** Token di versione da rimandare con ogni modifica (controllo concorrenza) */
+  versione: string;
+  /** Data odierna YYYY-MM-DD usata per lo stato dei periodi e per le regole */
+  oggi: string;
+}
+
+/** Esito di una modifica allo storico. */
+export type EsitoModificaStoricoTariffe =
+  | { esito: "SALVATO" }
+  | { esito: "ERRORI"; errori: ErroriValiditaTariffa };
+
+export const MESSAGGIO_STORICO_MODIFICATO =
+  "Le tariffe sono state modificate nel frattempo da un'altra operazione: lo storico è stato aggiornato, verificalo prima di riprovare";
+
+// ── Date ────────────────────────────────────────────────────────
+
+/**
+ * Data YYYY-MM-DD di una colonna `@db.Date`. Prisma restituisce queste colonne
+ * a mezzanotte UTC: la parte di data va letta in UTC, indipendentemente dal
+ * fuso del server.
+ */
+export function dataIsoDaColonnaDate(data: Date): string {
+  return data.toISOString().slice(0, 10);
+}
+
+/** Valore da scrivere in una colonna `@db.Date` per una data YYYY-MM-DD. */
+export function colonnaDateDaIso(dataIso: string): Date {
+  return new Date(`${dataIso}T00:00:00.000Z`);
+}
+
+/** Data odierna YYYY-MM-DD nel fuso del server (lo stesso del calendario attività). */
+export function dataOdiernaIso(adesso: Date = new Date()): string {
+  const anno = adesso.getFullYear();
+  const mese = String(adesso.getMonth() + 1).padStart(2, "0");
+  const giorno = String(adesso.getDate()).padStart(2, "0");
+  return `${anno}-${mese}-${giorno}`;
+}
+
+// ── Lettura dello storico (senza guardia) ───────────────────────
+
+/**
+ * Selezione Prisma dello storico tariffe da includere in una relazione
+ * `tariffe`, in ordine cronologico.
+ */
+export const SELEZIONE_STORICO_TARIFFE = {
+  select: { id: true, validaDal: true, tariffaGiornaliera: true, updatedAt: true },
+  orderBy: { validaDal: "asc" },
+} as const satisfies {
+  select: Record<string, true>;
+  orderBy: { validaDal: "asc" };
+};
+
+/**
+ * Importo di una colonna Decimal(10, 2) nel formato normalizzato "550.00":
+ * `Decimal.toString()` di Prisma omette gli zeri finali ("550").
+ */
+function importoNormalizzato(importo: { toString(): string }): string {
+  const testo = importo.toString();
+  return normalizzaTariffaGiornaliera(testo)?.valore ?? testo;
+}
+
+/** Converte le righe di storico lette da Prisma in validità di dominio. */
+export function validitaDaRigheDb(
+  righe: readonly RigaStoricoTariffaDb[],
+): ValiditaTariffa[] {
+  return righe.map((riga) => ({
+    id: riga.id,
+    validaDal: dataIsoDaColonnaDate(riga.validaDal),
+    tariffaGiornaliera: importoNormalizzato(riga.tariffaGiornaliera),
+  }));
+}
+
+/**
+ * Tariffa vigente a una data, a partire dallo storico letto da Prisma.
+ *
+ * Uno storico ben formato parte dalla data d'origine e copre ogni data: se
+ * nessuna validità copre la data lo storico è corrotto, e l'errore esplicito
+ * evita di valorizzare silenziosamente un consuntivo a zero.
+ *
+ * @param righe - Storico dell'entità (relazione `tariffe`)
+ * @param dataIso - Data YYYY-MM-DD di riferimento
+ * @param descrizioneEntita - Descrizione per il messaggio d'errore
+ */
+export function tariffaVigenteDaStoricoDb(
+  righe: readonly RigaStoricoTariffaDb[],
+  dataIso: string,
+  descrizioneEntita: string,
+): string {
+  const tariffa = tariffaVigenteAl(validitaDaRigheDb(righe), dataIso);
+  if (tariffa === null) {
+    throw new Error(
+      `Nessuna tariffa vigente al ${dataIso} per ${descrizioneEntita}: storico tariffe incompleto`,
+    );
+  }
+  return tariffa;
+}
+
+/**
+ * Dati di creazione della validità d'origine, per le `create` annidate di
+ * Offerta e Collaboratore: la tariffa indicata alla creazione vale dall'origine.
+ */
+export function validitaOrigineDaCreare(tariffaNormalizzata: string): {
+  create: { validaDal: Date; tariffaGiornaliera: string };
+} {
+  return {
+    create: {
+      validaDal: colonnaDateDaIso(DATA_ORIGINE_VALIDITA),
+      tariffaGiornaliera: tariffaNormalizzata,
+    },
+  };
+}
+
+type ClientTransazione = Prisma.TransactionClient;
+
+async function leggiRigheStorico(
+  client: ClientTransazione | typeof db,
+  tipoEntita: TipoEntitaTariffa,
+  entitaId: string,
+): Promise<RigaStoricoTariffaDb[]> {
+  return tipoEntita === "OFFERTA"
+    ? client.tariffaOfferta.findMany({
+        where: { offertaId: entitaId },
+        ...SELEZIONE_STORICO_TARIFFE,
+      })
+    : client.tariffaCollaboratore.findMany({
+        where: { collaboratoreId: entitaId },
+        ...SELEZIONE_STORICO_TARIFFE,
+      });
+}
+
+function versioneDaRigheDb(righe: readonly RigaStoricoTariffaDb[]): string {
+  return versioneStorico(
+    righe.map((riga) => ({
+      id: riga.id,
+      validaDal: dataIsoDaColonnaDate(riga.validaDal),
+      tariffaGiornaliera: importoNormalizzato(riga.tariffaGiornaliera),
+      aggiornataIl: riga.updatedAt.toISOString(),
+    })),
+  );
+}
+
+// ── API back-office (solo amministratore) ───────────────────────
+
+/**
+ * Restituisce lo storico tariffe di un'offerta o di un collaboratore, con i
+ * periodi derivati e il token di versione per le modifiche.
+ * Accesso riservato all'amministratore.
+ */
+export async function storicoTariffe(
+  tipoEntita: TipoEntitaTariffa,
+  entitaId: string,
+): Promise<StoricoTariffe> {
+  await richiediRuoloApi("AMMINISTRATORE");
+
+  const righe = await leggiRigheStorico(db, tipoEntita, entitaId);
+  const oggi = dataOdiernaIso();
+
+  return {
+    tipoEntita,
+    entitaId,
+    periodi: periodiValidita(validitaDaRigheDb(righe), oggi),
+    versione: versioneDaRigheDb(righe),
+    oggi,
+  };
+}
+
+/**
+ * Esegue una modifica dello storico tariffe di un'entità in modo serializzato.
+ *
+ * Concorrenza: dentro la transazione la riga dell'entità (Offerta o
+ * Collaboratore) viene bloccata con `SELECT … FOR UPDATE`, quindi due modifiche
+ * sulla stessa entità non possono intrecciarsi: la seconda attende la prima e
+ * poi rilegge lo storico aggiornato. Il token di versione inviato dal form
+ * viene confrontato con lo storico riletto sotto lock: se nel frattempo è
+ * cambiato, la modifica viene rifiutata invece di sommarsi alla precedente.
+ * Il vincolo unico (entità, validaDal) resta l'ultima difesa a livello DB.
+ */
+async function modificaStoricoSottoLock(
+  tipoEntita: TipoEntitaTariffa,
+  entitaId: string,
+  versioneAttesa: string,
+  modifica: (
+    tx: ClientTransazione,
+    storico: ValiditaTariffa[],
+    oggi: string,
+  ) => Promise<ErroriValiditaTariffa | null>,
+): Promise<EsitoModificaStoricoTariffe> {
+  try {
+    return await db.$transaction(async (tx) => {
+      const bloccate =
+        tipoEntita === "OFFERTA"
+          ? await tx.$queryRaw<{ id: string }[]>`SELECT "id" FROM "Offerta" WHERE "id" = ${entitaId} FOR UPDATE`
+          : await tx.$queryRaw<{ id: string }[]>`SELECT "id" FROM "Collaboratore" WHERE "id" = ${entitaId} FOR UPDATE`;
+
+      if (bloccate.length === 0) {
+        return {
+          esito: "ERRORI",
+          errori: {
+            _form: tipoEntita === "OFFERTA" ? "Offerta non trovata" : "Collaboratore non trovato",
+          },
+        };
+      }
+
+      const righe = await leggiRigheStorico(tx, tipoEntita, entitaId);
+      if (versioneDaRigheDb(righe) !== versioneAttesa) {
+        return { esito: "ERRORI", errori: { _form: MESSAGGIO_STORICO_MODIFICATO } };
+      }
+
+      const errori = await modifica(tx, validitaDaRigheDb(righe), dataOdiernaIso());
+      if (errori && Object.keys(errori).length > 0) {
+        return { esito: "ERRORI", errori };
+      }
+
+      return { esito: "SALVATO" };
+    });
+  } catch (error) {
+    if (
+      typeof error === "object" &&
+      error !== null &&
+      "code" in error &&
+      (error as { code?: string }).code === "P2002"
+    ) {
+      return { esito: "ERRORI", errori: { _form: MESSAGGIO_STORICO_MODIFICATO } };
+    }
+    throw error;
+  }
+}
+
+function normalizzaDati(dati: DatiValiditaTariffaInput): DatiValiditaTariffaInput {
+  return {
+    validaDal: dati.validaDal.trim(),
+    tariffaGiornaliera: dati.tariffaGiornaliera.trim(),
+  };
+}
+
+/**
+ * Inserisce una nuova validità in coda allo storico (tipicamente una tariffa
+ * futura). La validità precedente si chiude implicitamente il giorno prima.
+ * Accesso riservato all'amministratore.
+ */
+export async function inserisciValiditaTariffa(
+  tipoEntita: TipoEntitaTariffa,
+  entitaId: string,
+  versioneAttesa: string,
+  datiGrezzi: DatiValiditaTariffaInput,
+): Promise<EsitoModificaStoricoTariffe> {
+  await richiediRuoloApi("AMMINISTRATORE");
+  const dati = normalizzaDati(datiGrezzi);
+
+  return modificaStoricoSottoLock(
+    tipoEntita,
+    entitaId,
+    versioneAttesa,
+    async (tx, storico, oggi) => {
+      const errori = validaNuovaValidita(storico, dati, oggi);
+      if (Object.keys(errori).length > 0) {
+        return errori;
+      }
+
+      const tariffa = normalizzaTariffaGiornaliera(dati.tariffaGiornaliera)!.valore;
+      const validaDal = colonnaDateDaIso(dati.validaDal);
+
+      if (tipoEntita === "OFFERTA") {
+        await tx.tariffaOfferta.create({
+          data: { offertaId: entitaId, validaDal, tariffaGiornaliera: tariffa },
+        });
+      } else {
+        await tx.tariffaCollaboratore.create({
+          data: { collaboratoreId: entitaId, validaDal, tariffaGiornaliera: tariffa },
+        });
+      }
+      return null;
+    },
+  );
+}
+
+/**
+ * Corregge importo e, se ammesso, data di inizio dell'ultima validità.
+ * Accesso riservato all'amministratore.
+ */
+export async function correggiUltimaValiditaTariffa(
+  tipoEntita: TipoEntitaTariffa,
+  entitaId: string,
+  versioneAttesa: string,
+  datiGrezzi: DatiValiditaTariffaInput,
+): Promise<EsitoModificaStoricoTariffe> {
+  await richiediRuoloApi("AMMINISTRATORE");
+  const dati = normalizzaDati(datiGrezzi);
+
+  return modificaStoricoSottoLock(
+    tipoEntita,
+    entitaId,
+    versioneAttesa,
+    async (tx, storico, oggi) => {
+      const errori = validaCorrezioneUltimaValidita(storico, dati, oggi);
+      if (Object.keys(errori).length > 0) {
+        return errori;
+      }
+
+      const ultima = ordinaValidita(storico).at(-1)!;
+      const data = {
+        validaDal: colonnaDateDaIso(dati.validaDal),
+        tariffaGiornaliera: normalizzaTariffaGiornaliera(dati.tariffaGiornaliera)!.valore,
+      };
+
+      if (tipoEntita === "OFFERTA") {
+        await tx.tariffaOfferta.update({ where: { id: ultima.id }, data });
+      } else {
+        await tx.tariffaCollaboratore.update({ where: { id: ultima.id }, data });
+      }
+      return null;
+    },
+  );
+}
+
+/**
+ * Elimina l'ultima validità se non è ancora iniziata: la precedente torna
+ * aperta. Accesso riservato all'amministratore.
+ */
+export async function eliminaUltimaValiditaTariffa(
+  tipoEntita: TipoEntitaTariffa,
+  entitaId: string,
+  versioneAttesa: string,
+): Promise<EsitoModificaStoricoTariffe> {
+  await richiediRuoloApi("AMMINISTRATORE");
+
+  return modificaStoricoSottoLock(
+    tipoEntita,
+    entitaId,
+    versioneAttesa,
+    async (tx, storico, oggi) => {
+      const errore = validaEliminazioneUltimaValidita(storico, oggi);
+      if (errore) {
+        return { _form: errore };
+      }
+
+      const ultima = ordinaValidita(storico).at(-1)!;
+      if (tipoEntita === "OFFERTA") {
+        await tx.tariffaOfferta.delete({ where: { id: ultima.id } });
+      } else {
+        await tx.tariffaCollaboratore.delete({ where: { id: ultima.id } });
+      }
+      return null;
+    },
+  );
+}
