+// Modulo di dominio Tariffe — validità nel tempo delle tariffe giornaliere
+// di Offerta (prezzo al cliente) e Collaboratore (compenso).
+// Nessuna dipendenza da framework — funzioni pure.
+//
+// Modello: lo storico di un'entità è un elenco di validità identificate dalla
+// sola data di inizio (`validaDal`, formato YYYY-MM-DD). Ogni validità termina
+// il giorno prima dell'inizio della successiva; l'ultima resta aperta. La prima
+// validità parte sempre da DATA_ORIGINE_VALIDITA. Così sovrapposizioni e buchi
+// sono impossibili per costruzione: le regole qui sotto custodiscono solo
+// l'ordine strettamente crescente delle date e l'intangibilità del passato.
+
+import { validaCampoTariffaGiornaliera } from "../anagrafiche/valida-collaboratore";
+
+// ── Tipi ────────────────────────────────────────────────────────
+
+/** Data d'origine della prima validità: copre ogni riga attività possibile. */
+export const DATA_ORIGINE_VALIDITA = "1900-01-01";
+
+/** Validità di una tariffa giornaliera, serializzabile. */
+export interface ValiditaTariffa {
+  id: string;
+  /** Data di inizio validità, YYYY-MM-DD */
+  validaDal: string;
+  /** Importo normalizzato, es. "550.00" */
+  tariffaGiornaliera: string;
+}
+
+/** Stato di una validità rispetto alla data odierna. */
+export type StatoValiditaTariffa = "STORICA" | "VIGENTE" | "FUTURA";
+
+/** Validità con la data di fine derivata, pronta per la UI. */
+export interface PeriodoValiditaTariffa extends ValiditaTariffa {
+  /** Ultimo giorno di validità (incluso), null se la validità è aperta */
+  validaAl: string | null;
+  /** True per la validità d'origine (nessuna data di inizio effettiva) */
+  origine: boolean;
+  stato: StatoValiditaTariffa;
+}
+
+/** Mappa campo → messaggio di errore. Vuota se la validazione passa. */
+export type ErroriValiditaTariffa = Record<string, string>;
+
+/** Dati in ingresso per inserire o correggere una validità. */
+export interface DatiValiditaTariffaInput {
+  validaDal: string;
+  tariffaGiornaliera: string;
+}
+
+// ── Date ────────────────────────────────────────────────────────
+
+const RE_DATA_ISO = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/** True se la stringa è una data di calendario esistente nel formato YYYY-MM-DD. */
+export function eDataIsoValida(valore: string): boolean {
+  const corrispondenza = RE_DATA_ISO.exec(valore);
+  if (!corrispondenza) {
+    return false;
+  }
+  const [, anno, mese, giorno] = corrispondenza.map(Number);
+  const data = new Date(Date.UTC(anno, mese - 1, giorno));
+  return (
+    data.getUTCFullYear() === anno &&
+    data.getUTCMonth() === mese - 1 &&
+    data.getUTCDate() === giorno
+  );
+}
+
+/** Giorno precedente di una data YYYY-MM-DD. */
+export function giornoPrecedente(dataIso: string): string {
+  const [anno, mese, giorno] = dataIso.split("-").map(Number);
+  return new Date(Date.UTC(anno, mese - 1, giorno - 1)).toISOString().slice(0, 10);
+}
+
+/** Formatta una data YYYY-MM-DD come gg/mm/aaaa. */
+export function formattaDataValidita(dataIso: string): string {
+  const [anno, mese, giorno] = dataIso.split("-");
+  return `${giorno}/${mese}/${anno}`;
+}
+
+// ── Lettura dello storico ───────────────────────────────────────
+
+/** Restituisce una copia dello storico ordinata per data di inizio crescente. */
+export function ordinaValidita<T extends Pick<ValiditaTariffa, "validaDal">>(
+  storico: readonly T[],
+): T[] {
+  return [...storico].sort((a, b) => a.validaDal.localeCompare(b.validaDal));
+}
+
+/**
+ * Tariffa vigente a una data: quella della validità con la data di inizio più
+ * recente non successiva alla data. Null se nessuna validità copre la data
+ * (impossibile con uno storico che parte dalla data d'origine).
+ *
+ * @param storico - Validità dell'entità, in qualunque ordine
+ * @param dataIso - Data di riferimento YYYY-MM-DD (tipicamente la data della riga)
+ */
+export function tariffaVigenteAl(
+  storico: readonly Pick<ValiditaTariffa, "validaDal" | "tariffaGiornaliera">[],
+  dataIso: string,
+): string | null {
+  let vigente: Pick<ValiditaTariffa, "validaDal" | "tariffaGiornaliera"> | null = null;
+  for (const validita of storico) {
+    if (
+      validita.validaDal <= dataIso &&
+      (vigente === null || validita.validaDal > vigente.validaDal)
+    ) {
+      vigente = validita;
+    }
+  }
+  return vigente?.tariffaGiornaliera ?? null;
+}
+
+/**
+ * Deriva i periodi di validità (con data di fine e stato rispetto a oggi) da
+ * uno storico, in ordine cronologico.
+ */
+export function periodiValidita(
+  storico: readonly ValiditaTariffa[],
+  oggiIso: string,
+): PeriodoValiditaTariffa[] {
+  const ordinate = ordinaValidita(storico);
+  return ordinate.map((validita, indice) => {
+    const successiva = ordinate[indice + 1];
+    const validaAl = successiva ? giornoPrecedente(successiva.validaDal) : null;
+    let stato: StatoValiditaTariffa;
+    if (validita.validaDal > oggiIso) {
+      stato = "FUTURA";
+    } else if (validaAl !== null && validaAl < oggiIso) {
+      stato = "STORICA";
+    } else {
+      stato = "VIGENTE";
+    }
+    return {
+      ...validita,
+      validaAl,
+      origine: validita.validaDal === DATA_ORIGINE_VALIDITA,
+      stato,
+    };
+  });
+}
+
+/**
+ * Token di versione dello storico: cambia a ogni inserimento, correzione o
+ * eliminazione. Il form lo rimanda indietro e il salvataggio lo confronta, sotto
+ * lock, con lo storico corrente: due modifiche concorrenti partite dalla stessa
+ * versione non possono andare entrambe a buon fine.
+ */
+export function versioneStorico(
+  storico: readonly (ValiditaTariffa & { aggiornataIl: string })[],
+): string {
+  return ordinaValidita(storico)
+    .map((v) => `${v.id}@${v.validaDal}@${v.tariffaGiornaliera}@${v.aggiornataIl}`)
+    .join("|");
+}
+
+// ── Regole di modifica ──────────────────────────────────────────
+
+function validaCampoValidaDal(valore: string): string | null {
+  if (!valore || valore.trim() === "") {
+    return "La data di inizio validità è obbligatoria";
+  }
+  if (!eDataIsoValida(valore.trim())) {
+    return "Inserisci una data valida";
+  }
+  return null;
+}
+
+/**
+ * Valida l'inserimento di una nuova validità in coda allo storico.
+ *
+ * Regole:
+ * - data obbligatoria e valida, tariffa obbligatoria, > 0, massimo 2 decimali;
+ * - la data deve essere successiva all'inizio dell'ultima validità (niente
+ *   sovrapposizioni: la nuova chiude l'ultima il giorno prima);
+ * - la data non può essere nel passato (da oggi in poi): i conti dei giorni già
+ *   trascorsi restano con la tariffa che era vigente.
+ */
+export function validaNuovaValidita(
+  storico: readonly ValiditaTariffa[],
+  dati: DatiValiditaTariffaInput,
+  oggiIso: string,
+): ErroriValiditaTariffa {
+  const errori: ErroriValiditaTariffa = {};
+
+  const erroreTariffa = validaCampoTariffaGiornaliera(dati.tariffaGiornaliera);
+  if (erroreTariffa) {
+    errori.tariffaGiornaliera = erroreTariffa;
+  }
+
+  const erroreData = validaCampoValidaDal(dati.validaDal);
+  if (erroreData) {
+    errori.validaDal = erroreData;
+    return errori;
+  }
+
+  const validaDal = dati.validaDal.trim();
+  const ultima = ordinaValidita(storico).at(-1);
+
+  if (ultima && validaDal <= ultima.validaDal) {
+    errori.validaDal = ultima.validaDal === DATA_ORIGINE_VALIDITA
+      ? "La data di inizio deve essere successiva all'origine"
+      : `La data di inizio deve essere successiva al ${formattaDataValidita(ultima.validaDal)}, inizio dell'ultima tariffa`;
+  } else if (validaDal < oggiIso) {
+    errori.validaDal =
+      "La data di inizio non può essere nel passato: i giorni già trascorsi mantengono la tariffa vigente";
+  }
+
+  return errori;
+}
+
+/**
+ * Valida la correzione dell'ultima validità dello storico.
+ *
+ * Regole:
+ * - l'importo è sempre correggibile (> 0, massimo 2 decimali);
+ * - la validità d'origine non può cambiare data (resterebbe un buco iniziale);
+ * - la data di una validità successiva può cambiare solo se sia la data
+ *   attuale sia quella nuova sono da oggi in poi, e deve restare successiva
+ *   all'inizio della validità precedente.
+ */
+export function validaCorrezioneUltimaValidita(
+  storico: readonly ValiditaTariffa[],
+  dati: DatiValiditaTariffaInput,
+  oggiIso: string,
+): ErroriValiditaTariffa {
+  const errori: ErroriValiditaTariffa = {};
+  const ordinate = ordinaValidita(storico);
+  const ultima = ordinate.at(-1);
+
+  if (!ultima) {
+    return { _form: "Nessuna tariffa da correggere" };
+  }
+
+  const erroreTariffa = validaCampoTariffaGiornaliera(dati.tariffaGiornaliera);
+  if (erroreTariffa) {
+    errori.tariffaGiornaliera = erroreTariffa;
+  }
+
+  const erroreData = validaCampoValidaDal(dati.validaDal);
+  if (erroreData) {
+    errori.validaDal = erroreData;
+    return errori;
+  }
+
+  const validaDal = dati.validaDal.trim();
+  if (validaDal === ultima.validaDal) {
+    return errori;
+  }
+
+  const precedente = ordinate.at(-2);
+  if (!precedente) {
+    errori.validaDal = "La prima tariffa vale dall'origine: la data non è modificabile";
+  } else if (ultima.validaDal < oggiIso) {
+    errori.validaDal =
+      "La tariffa è già in vigore da giorni trascorsi: puoi correggere l'importo, non la data";
+  } else if (validaDal < oggiIso) {
+    errori.validaDal =
+      "La data di inizio non può essere nel passato: i giorni già trascorsi mantengono la tariffa vigente";
+  } else if (validaDal <= precedente.validaDal) {
+    errori.validaDal = precedente.validaDal === DATA_ORIGINE_VALIDITA
+      ? "La data di inizio deve essere successiva all'origine"
+      : `La data di inizio deve essere successiva al ${formattaDataValidita(precedente.validaDal)}, inizio della tariffa precedente`;
+  }
+
+  return errori;
+}
+
+/**
+ * Valida l'eliminazione dell'ultima validità: ammessa solo per una validità
+ * non d'origine che non è ancora iniziata (da oggi in poi), così nessun giorno
+ * trascorso cambia tariffa.
+ */
+export function validaEliminazioneUltimaValidita(
+  storico: readonly ValiditaTariffa[],
+  oggiIso: string,
+): string | null {
+  const ordinate = ordinaValidita(storico);
+  const ultima = ordinate.at(-1);
+  if (!ultima || ordinate.length < 2) {
+    return "La prima tariffa non può essere eliminata";
+  }
+  if (ultima.validaDal < oggiIso) {
+    return "La tariffa è già in vigore da giorni trascorsi: non può essere eliminata";
+  }
+  return null;
+}
