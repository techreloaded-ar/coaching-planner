+++ b/tests/unit/tariffe-dal-actions.test.ts
@@ -0,0 +1,562 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+
+// ── Finto database in memoria con lock di riga ─────────────────────
+//
+// Riproduce il comportamento rilevante di PostgreSQL per lo storico tariffe:
+// `SELECT … FOR UPDATE` sull'entità blocca le altre transazioni che chiedono lo
+// stesso lock fino al commit, e il vincolo unico (entità, validaDal) rifiuta i
+// duplicati con P2002. Le scritture sono visibili alle altre transazioni solo
+// dopo il commit, come in READ COMMITTED.
+
+interface RigaTariffaFinta {
+  id: string;
+  entitaId: string;
+  validaDal: Date;
+  tariffaGiornaliera: string;
+  updatedAt: Date;
+}
+
+const finto = vi.hoisted(() => {
+  const stato = {
+    entitaEsistenti: new Set<string>(),
+    righe: [] as RigaTariffaFinta[],
+    lock: new Map<string, Promise<void>>(),
+    sequenza: 0,
+    operazioni: [] as string[],
+  };
+
+  function delegato(campoEntita: "offertaId" | "collaboratoreId", scritture: RigaTariffaFinta[], rimozioni: Set<string>, aggiornamenti: Map<string, Partial<RigaTariffaFinta>>) {
+    return {
+      findMany: vi.fn(async (args: { where: Record<string, string> }) => {
+        stato.operazioni.push("lettura-storico");
+        const entitaId = args.where[campoEntita];
+        return stato.righe
+          .filter((riga) => riga.entitaId === entitaId)
+          .sort((a, b) => a.validaDal.getTime() - b.validaDal.getTime())
+          .map((riga) => ({
+            id: riga.id,
+            validaDal: riga.validaDal,
+            tariffaGiornaliera: { toString: () => riga.tariffaGiornaliera },
+            updatedAt: riga.updatedAt,
+          }));
+      }),
+      create: vi.fn(async (args: { data: Record<string, unknown> }) => {
+        stato.operazioni.push("inserimento");
+        scritture.push({
+          id: `t-${++stato.sequenza}`,
+          entitaId: args.data[campoEntita] as string,
+          validaDal: args.data.validaDal as Date,
+          tariffaGiornaliera: args.data.tariffaGiornaliera as string,
+          updatedAt: new Date(Date.now() + stato.sequenza),
+        });
+      }),
+      update: vi.fn(async (args: { where: { id: string }; data: Partial<RigaTariffaFinta> }) => {
+        stato.operazioni.push("correzione");
+        aggiornamenti.set(args.where.id, args.data);
+      }),
+      delete: vi.fn(async (args: { where: { id: string } }) => {
+        stato.operazioni.push("eliminazione");
+        rimozioni.add(args.where.id);
+      }),
+    };
+  }
+
+  async function transazione<T>(callback: (tx: unknown) => Promise<T>): Promise<T> {
+    const scritture: RigaTariffaFinta[] = [];
+    const rimozioni = new Set<string>();
+    const aggiornamenti = new Map<string, Partial<RigaTariffaFinta>>();
+    const lockAcquisiti: (() => void)[] = [];
+
+    const tx = {
+      $queryRaw: vi.fn(async (strings: TemplateStringsArray, entitaId: string) => {
+        stato.operazioni.push(`lock:${strings.join("?")}`);
+        while (stato.lock.has(entitaId)) {
+          await stato.lock.get(entitaId);
+        }
+        let rilascia!: () => void;
+        stato.lock.set(entitaId, new Promise<void>((resolve) => (rilascia = resolve)));
+        lockAcquisiti.push(() => {
+          stato.lock.delete(entitaId);
+          rilascia();
+        });
+        return stato.entitaEsistenti.has(entitaId) ? [{ id: entitaId }] : [];
+      }),
+      tariffaOfferta: delegato("offertaId", scritture, rimozioni, aggiornamenti),
+      tariffaCollaboratore: delegato("collaboratoreId", scritture, rimozioni, aggiornamenti),
+    };
+
+    try {
+      const risultato = await callback(tx);
+      // Commit: vincolo unico (entità, validaDal) e pubblicazione delle scritture
+      for (const nuova of scritture) {
+        const duplicata = stato.righe.some(
+          (riga) =>
+            riga.entitaId === nuova.entitaId &&
+            riga.validaDal.getTime() === nuova.validaDal.getTime(),
+        );
+        if (duplicata) {
+          throw Object.assign(new Error("Unique constraint failed"), { code: "P2002" });
+        }
+      }
+      stato.righe = stato.righe
+        .filter((riga) => !rimozioni.has(riga.id))
+        .map((riga) =>
+          aggiornamenti.has(riga.id)
+            ? { ...riga, ...aggiornamenti.get(riga.id), updatedAt: new Date(Date.now() + ++stato.sequenza) }
+            : riga,
+        )
+        .concat(scritture);
+      return risultato;
+    } finally {
+      for (const rilascia of lockAcquisiti) rilascia();
+    }
+  }
+
+  const db = {
+    $transaction: vi.fn(transazione),
+    tariffaOfferta: delegato("offertaId", stato.righe, new Set(), new Map()),
+    tariffaCollaboratore: delegato("collaboratoreId", stato.righe, new Set(), new Map()),
+  };
+
+  return { stato, db };
+});
+
+vi.mock("@/lib/db", () => ({ db: finto.db }));
+
+const { mockRichiediRuoloApi } = vi.hoisted(() => ({
+  mockRichiediRuoloApi: vi.fn(),
+}));
+
+vi.mock("@/lib/dal", () => ({
+  richiediRuoloApi: mockRichiediRuoloApi,
+}));
+
+const { mockRevalidatePath } = vi.hoisted(() => ({
+  mockRevalidatePath: vi.fn(),
+}));
+
+vi.mock("next/cache", () => ({
+  revalidatePath: mockRevalidatePath,
+}));
+
+import {
+  MESSAGGIO_STORICO_MODIFICATO,
+  correggiUltimaValiditaTariffa,
+  eliminaUltimaValiditaTariffa,
+  inserisciValiditaTariffa,
+  storicoTariffe,
+} from "@/lib/tariffe";
+import {
+  correggiUltimaValiditaTariffaAction,
+  eliminaUltimaValiditaTariffaAction,
+  inserisciValiditaTariffaAction,
+} from "@/app/(back-office)/anagrafiche/_storico-tariffe/actions";
+
+// ── Helper ──────────────────────────────────────────────────────
+
+function dataColonna(dataIso: string): Date {
+  return new Date(`${dataIso}T00:00:00.000Z`);
+}
+
+function preparaStorico(entitaId: string, validita: [string, string][]) {
+  finto.stato.entitaEsistenti.add(entitaId);
+  for (const [validaDal, tariffa] of validita) {
+    finto.stato.righe.push({
+      id: `t-${++finto.stato.sequenza}`,
+      entitaId,
+      validaDal: dataColonna(validaDal),
+      tariffaGiornaliera: tariffa,
+      updatedAt: new Date("2026-01-01T00:00:00.000Z"),
+    });
+  }
+}
+
+function storicoSalvato(entitaId: string): [string, string][] {
+  return finto.stato.righe
+    .filter((riga) => riga.entitaId === entitaId)
+    .sort((a, b) => a.validaDal.getTime() - b.validaDal.getTime())
+    .map((riga) => [riga.validaDal.toISOString().slice(0, 10), riga.tariffaGiornaliera]);
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(new Date(2026, 9, 22, 12, 0, 0));
+  finto.stato.entitaEsistenti.clear();
+  finto.stato.righe.length = 0;
+  finto.stato.lock.clear();
+  finto.stato.operazioni.length = 0;
+  mockRichiediRuoloApi.mockResolvedValue(undefined);
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+// ═══════════════════════════════════════════════════════════════
+// Lettura dello storico
+// ═══════════════════════════════════════════════════════════════
+
+describe("storicoTariffe", () => {
+  it("restituisce i periodi derivati rispetto a oggi e la versione dello storico", async () => {
+    preparaStorico("off-1", [
+      ["1900-01-01", "550.00"],
+      ["2026-01-01", "600.00"],
+      ["2027-01-01", "650.00"],
+    ]);
+
+    const storico = await storicoTariffe("OFFERTA", "off-1");
+
+    expect(mockRichiediRuoloApi).toHaveBeenCalledWith("AMMINISTRATORE");
+    expect(storico.oggi).toBe("2026-10-22");
+    expect(storico.periodi.map((p) => [p.validaDal, p.validaAl, p.stato])).toEqual([
+      ["1900-01-01", "2025-12-31", "STORICA"],
+      ["2026-01-01", "2026-12-31", "VIGENTE"],
+      ["2027-01-01", null, "FUTURA"],
+    ]);
+    expect(storico.versione).not.toBe("");
+  });
+
+  it("non legge lo storico senza ruolo amministratore", async () => {
+    mockRichiediRuoloApi.mockRejectedValue(new Error("Accesso negato"));
+
+    await expect(storicoTariffe("COLLABORATORE", "col-1")).rejects.toThrow("Accesso negato");
+    expect(finto.stato.operazioni).toEqual([]);
+  });
+});
+
+// ═══════════════════════════════════════════════════════════════
+// Inserimento
+// ═══════════════════════════════════════════════════════════════
+
+describe("inserisciValiditaTariffa", () => {
+  it("blocca la riga dell'entità prima di leggere e scrivere lo storico", async () => {
+    preparaStorico("off-1", [["1900-01-01", "550.00"]]);
+    const { versione } = await storicoTariffe("OFFERTA", "off-1");
+    finto.stato.operazioni.length = 0;
+
+    const esito = await inserisciValiditaTariffa("OFFERTA", "off-1", versione, {
+      validaDal: "2027-01-01",
+      tariffaGiornaliera: "600,00",
+    });
+
+    expect(esito).toEqual({ esito: "SALVATO" });
+    expect(finto.stato.operazioni).toEqual([
+      'lock:SELECT "id" FROM "Offerta" WHERE "id" = ? FOR UPDATE',
+      "lettura-storico",
+      "inserimento",
+    ]);
+    expect(storicoSalvato("off-1")).toEqual([
+      ["1900-01-01", "550.00"],
+      ["2027-01-01", "600.00"],
+    ]);
+  });
+
+  it("blocca la riga del collaboratore per lo storico del collaboratore", async () => {
+    preparaStorico("col-1", [["1900-01-01", "350.00"]]);
+    const { versione } = await storicoTariffe("COLLABORATORE", "col-1");
+    finto.stato.operazioni.length = 0;
+
+    await inserisciValiditaTariffa("COLLABORATORE", "col-1", versione, {
+      validaDal: "2027-01-01",
+      tariffaGiornaliera: "380",
+    });
+
+    expect(finto.stato.operazioni[0]).toBe(
+      'lock:SELECT "id" FROM "Collaboratore" WHERE "id" = ? FOR UPDATE',
+    );
+    expect(storicoSalvato("col-1")).toEqual([
+      ["1900-01-01", "350.00"],
+      ["2027-01-01", "380.00"],
+    ]);
+  });
+
+  it("restituisce gli errori di validazione senza scrivere", async () => {
+    preparaStorico("off-1", [["1900-01-01", "550.00"]]);
+    const { versione } = await storicoTariffe("OFFERTA", "off-1");
+
+    const esito = await inserisciValiditaTariffa("OFFERTA", "off-1", versione, {
