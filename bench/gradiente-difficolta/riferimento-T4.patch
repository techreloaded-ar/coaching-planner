@@ -0,0 +1,199 @@
+import { describe, it, expect } from "vitest";
+import {
+  calcolaAvanzamentoOfferte,
+  calcolaReportFatturazioneClienti,
+  calcolaRiepilogoMese,
+  type OffertaAvanzamento,
+  type RigaAvanzamento,
+  type RigaReportFatturazione,
+  type RigaRiepilogo,
+} from "@/domain/consuntivi";
+
+// Regressione: le giornate (8 ore) vanno calcolate sommando prima le ore e
+// convertendo poi, senza troncare le frazioni di ogni singola riga. Riepilogo
+// mensile e avanzamento offerte devono restare coerenti con il report
+// fatturazione per le stesse ore (le tariffe possono differire).
+
+const TARIFFA_COLLABORATORE_ADA = 400;
+const TARIFFA_OFFERTA = 640;
+
+function rigaRiepilogo(modifiche: Partial<RigaRiepilogo> = {}): RigaRiepilogo {
+  return {
+    offertaId: "offerta-ada",
+    offertaCodice: "OFF-ADA",
+    offertaDescrizione: "Consulenza",
+    clienteRagioneSociale: "Cliente Esempio",
+    ore: 3,
+    fatturabile: true,
+    rimborsoTrasfertaImporto: null,
+    ...modifiche,
+  };
+}
+
+function rigaReport(modifiche: Partial<RigaReportFatturazione> = {}): RigaReportFatturazione {
+  return {
+    clienteId: "cliente-esempio",
+    clienteRagioneSociale: "Cliente Esempio",
+    offertaId: "offerta-ada",
+    offertaCodice: "OFF-ADA",
+    offertaDescrizione: "Consulenza",
+    tariffaOffertaGiornaliera: TARIFFA_OFFERTA,
+    collaboratoreId: "ada-esempio",
+    collaboratoreNome: "Ada Esempio",
+    ore: 3,
+    fatturabile: true,
+    rimborsoTrasfertaImporto: null,
+    ...modifiche,
+  };
+}
+
+function rigaAvanzamento(modifiche: Partial<RigaAvanzamento> = {}): RigaAvanzamento {
+  return {
+    offertaId: "offerta-ada",
+    collaboratoreId: "ada-esempio",
+    collaboratoreNome: "Ada Esempio",
+    ore: 3,
+    fatturabile: true,
+    mese: "2026-03",
+    ...modifiche,
+  };
+}
+
+const offertaAda: OffertaAvanzamento = {
+  offertaId: "offerta-ada",
+  offertaCodice: "OFF-ADA",
+  offertaDescrizione: "Consulenza",
+  clienteId: "cliente-esempio",
+  clienteRagioneSociale: "Cliente Esempio",
+  giorniPrevisti: 10,
+};
+
+describe("calcolaRiepilogoMese — frazioni di giornata", () => {
+  it("due righe fatturabili da 3 ore danno 0,75 giornate e 300 EUR a tariffa 400 (non 0,74 e 296)", () => {
+    // Ada Esempio, marzo 2026: righe del 12 e del 19
+    const riepilogo = calcolaRiepilogoMese(
+      [rigaRiepilogo(), rigaRiepilogo()],
+      TARIFFA_COLLABORATORE_ADA,
+    );
+
+    expect(riepilogo.totali.oreFatturabili).toBe(6);
+    expect(riepilogo.totali.giornateFatturabili).toBe(0.75);
+    expect(riepilogo.totali.giornateTotali).toBe(0.75);
+    expect(riepilogo.breakdown.giornateFatturabili).toBe("0.75");
+    expect(riepilogo.breakdown.imponibileManodopera).toBe("300.00");
+    expect(riepilogo.importoFattura).toBe("300.00");
+    expect(riepilogo.perOfferta).toHaveLength(1);
+    expect(riepilogo.perOfferta[0].giornateTotali).toBe(0.75);
+    expect(riepilogo.perOfferta[0].giornateFatturabili).toBe(0.75);
+  });
+
+  it("una riga da 8 ore resta una giornata intera (caso Marco Esempio)", () => {
+    const riepilogo = calcolaRiepilogoMese([rigaRiepilogo({ ore: 8 })], 400);
+
+    expect(riepilogo.totali.giornateFatturabili).toBe(1);
+    expect(riepilogo.breakdown.imponibileManodopera).toBe("400.00");
+  });
+
+  it("mantiene le frazioni per offerta e preserva righe non fatturabili e rimborsi", () => {
+    const riepilogo = calcolaRiepilogoMese(
+      [
+        rigaRiepilogo({ ore: 1 }),
+        rigaRiepilogo({ ore: 1, rimborsoTrasfertaImporto: "25.50" }),
+        rigaRiepilogo({ ore: 1, fatturabile: false }),
+        rigaRiepilogo({ offertaId: "offerta-b", offertaCodice: "OFF-B", ore: 0.5 }),
+        rigaRiepilogo({ offertaId: "offerta-b", offertaCodice: "OFF-B", ore: 0.5 }),
+      ],
+      TARIFFA_COLLABORATORE_ADA,
+    );
+
+    // 1 + 1 + 0,5 + 0,5 = 3 ore fatturabili → 0,375 giornate; 4 ore totali → 0,5
+    expect(riepilogo.totali.oreFatturabili).toBe(3);
+    expect(riepilogo.totali.giornateFatturabili).toBe(0.375);
+    expect(riepilogo.totali.giornateTotali).toBe(0.5);
+    expect(riepilogo.breakdown.imponibileManodopera).toBe("150.00");
+    expect(riepilogo.totali.totaleRimborsi).toBe("25.50");
+    expect(riepilogo.importoFattura).toBe("175.50");
+
+    const offertaA = riepilogo.perOfferta.find((voce) => voce.offertaId === "offerta-ada");
+    const offertaB = riepilogo.perOfferta.find((voce) => voce.offertaId === "offerta-b");
+    expect(offertaA?.giornateTotali).toBe(0.375);
+    expect(offertaA?.giornateFatturabili).toBe(0.25);
+    expect(offertaA?.rimborsiTrasferta).toBe("25.50");
+    expect(offertaB?.giornateTotali).toBe(0.125);
+    expect(offertaB?.giornateFatturabili).toBe(0.125);
+  });
+
+  it("giornate coerenti con il report fatturazione sulle stesse ore, con importi a tariffe diverse", () => {
+    const riepilogo = calcolaRiepilogoMese(
+      [rigaRiepilogo(), rigaRiepilogo()],
+      TARIFFA_COLLABORATORE_ADA,
+    );
+    const report = calcolaReportFatturazioneClienti([rigaReport(), rigaReport()]);
+    const voceOffertaReport = report.perCliente[0].perOfferta[0];
+
+    expect(voceOffertaReport.giornateFatturabili).toBe(riepilogo.totali.giornateFatturabili);
+    expect(voceOffertaReport.imponibile).toBe("480.00");
+    expect(riepilogo.breakdown.imponibileManodopera).toBe("300.00");
+  });
+});
+
+describe("calcolaAvanzamentoOfferte — frazioni di giornata", () => {
+  it("il totale erogato dell'offerta somma le ore prima di convertire (0,75, non 0,74)", () => {
+    const { perOfferta, totali } = calcolaAvanzamentoOfferte(
+      [offertaAda],
+      [rigaAvanzamento(), rigaAvanzamento()],
+    );
+
+    expect(perOfferta[0].giornateErogate).toBe(0.75);
+    expect(perOfferta[0].residuo).toBe(9.25);
+    expect(perOfferta[0].matriceMensile.totaleGiornate).toBe(0.75);
+    expect(perOfferta[0].perCollaboratore[0].giornateErogate).toBe(0.75);
+    expect(totali.giornateErogateTotali).toBe(0.75);
+  });
+
+  it("su più mesi (incluso ottobre, mese del cambio ora) il totale coincide con la somma della matrice", () => {
+    const { perOfferta } = calcolaAvanzamentoOfferte(
+      [offertaAda],
+      [
+        rigaAvanzamento({ mese: "2026-03" }),
+        rigaAvanzamento({ mese: "2026-03" }),
+        rigaAvanzamento({ mese: "2026-10" }),
+        rigaAvanzamento({ mese: "2026-10" }),
+        rigaAvanzamento({ mese: "2026-10", fatturabile: false }),
+      ],
+    );
+
+    const voce = perOfferta[0];
+    expect(voce.matriceMensile.totaliPerMese).toEqual({ "2026-03": 0.75, "2026-10": 0.75 });
+    expect(voce.giornateErogate).toBe(1.5);
+    expect(voce.matriceMensile.totaleGiornate).toBe(1.5);
+  });
+
+  it("l'erogato coincide con le giornate del report fatturazione per le stesse righe", () => {
+    const { perOfferta } = calcolaAvanzamentoOfferte(
+      [offertaAda],
+      [rigaAvanzamento(), rigaAvanzamento(), rigaAvanzamento({ ore: 1, fatturabile: false })],
+    );
+    const report = calcolaReportFatturazioneClienti([
+      rigaReport(),
+      rigaReport(),
+      rigaReport({ ore: 1, fatturabile: false }),
+    ]);
+
+    expect(perOfferta[0].giornateErogate).toBe(
+      report.perCliente[0].perOfferta[0].giornateFatturabili,
+    );
+  });
+
+  it("lo stato dipende dall'erogato non troncato: 4 righe da 5 ore su 2,5 giornate previste è ESAURITA", () => {
+    // Troncando per riga: 4 × 0,62 = 2,48 → IN_ALLERTA con residuo 0,02
+    const { perOfferta } = calcolaAvanzamentoOfferte(
+      [{ ...offertaAda, giorniPrevisti: 2.5 }],
+      Array.from({ length: 4 }, () => rigaAvanzamento({ ore: 5 })),
+    );
+
+    expect(perOfferta[0].giornateErogate).toBe(2.5);
+    expect(perOfferta[0].residuo).toBe(0);
+    expect(perOfferta[0].stato).toBe("ESAURITA");
+  });
+});
