diff --git a/tests/e2e/giornate-frazionarie-coerenti.spec.ts b/tests/e2e/giornate-frazionarie-coerenti.spec.ts
new file mode 100644
index 0000000..aa007b7
--- /dev/null
+++ b/tests/e2e/giornate-frazionarie-coerenti.spec.ts
@@ -0,0 +1,145 @@
+import { randomUUID } from "node:crypto";
+
+import type { Locator, Page } from "@playwright/test";
+
+import { accediAlBackOfficeComeAdmin, accediComeCollaboratore } from "./support/auth";
+import { dataNelMese, mesePassatoRiservato } from "./support/date";
+import { test, expect } from "./support/fixtures";
+import { apriPaginaOfferte } from "./support/offerte";
+
+// Regressione: due righe fatturabili da 3 ore nello stesso mese valgono
+// 0,75 giornate (non 0,74). Il riepilogo mensile e l'avanzamento offerte
+// devono mantenere le frazioni come il report fatturazione.
+const meseRiepilogo = mesePassatoRiservato("T4-GIORNATE-FRAZIONARIE");
+const TARIFFA_COLLABORATORE = "400.00";
+const TARIFFA_OFFERTA = "640.00";
+
+function dataDb(meseToken: string, giorno: number): Date {
+	return new Date(`${dataNelMese(meseToken, giorno)}T00:00:00.000Z`);
+}
+
+function testoLetterale(valore: string): RegExp {
+	return new RegExp(valore.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
+}
+
+function indicatore(region: Locator, etichetta: string): Locator {
+	return region.getByText(etichetta, { exact: true }).locator("..");
+}
+
+async function apriRiepilogo(page: Page, meseToken: string): Promise<void> {
+	await page.goto(`/attivita/riepilogo?mese=${meseToken}`);
+	await expect(page.getByTestId("summary-importo-fattura")).toBeVisible();
+}
+
+test.describe("Giornate frazionarie coerenti tra riepilogo, avanzamento e report", () => {
+	test("due righe da 3 ore: il riepilogo mostra 0,75 giornate e 300 EUR, non 0,74 e 296", async ({
+		page,
+		factory,
+	}) => {
+		const seed = randomUUID().slice(0, 8);
+		const ada = await factory.createCollaboratore({
+			nome: "Ada",
+			cognome: `Esempio ${seed}`,
+			tariffaGiornaliera: TARIFFA_COLLABORATORE,
+		});
+		const { cliente, offerta } = await factory.createClienteConOfferta(
+			{ ragioneSociale: `E2E Giornate Frazionarie ${seed}` },
+			{ codice: `FRAZ-${seed}`.toUpperCase(), tariffaGiornaliera: TARIFFA_OFFERTA },
+		);
+
+		for (const giorno of [12, 19]) {
+			await factory.createRigaAttivita({
+				collaboratore: ada,
+				cliente,
+				offerta,
+				data: dataDb(meseRiepilogo, giorno),
+				ore: "3.00",
+				fatturabile: true,
+				nota: `Ada ${seed} giorno ${giorno}`,
+			});
+		}
+
+		await accediComeCollaboratore(page, ada.utente.email);
+		await apriRiepilogo(page, meseRiepilogo);
+
+		await expect(page.getByTestId("summary-ore-fatturabili-value")).toHaveText("6");
+		await expect(page.getByTestId("summary-giornate-fatturabili")).toContainText("0,75");
+		await expect(page.getByTestId("summary-importo-fattura-value")).toHaveText(/300,00/);
+		await expect(page.getByTestId("summary-importo-fattura")).toContainText("0.75 g");
+
+		const rigaOfferta = page
+			.getByTestId("summary-table")
+			.getByRole("row", { name: testoLetterale(offerta.codice) });
+		await expect(rigaOfferta).toContainText("0,75");
+	});
+
+	test("una riga da 8 ore resta una giornata intera (caso senza sintomo)", async ({
+		page,
+		factory,
+	}) => {
+		const seed = randomUUID().slice(0, 8);
+		const marco = await factory.createCollaboratore({
+			nome: "Marco",
+			cognome: `Esempio ${seed}`,
+			tariffaGiornaliera: TARIFFA_COLLABORATORE,
+		});
+		const { cliente, offerta } = await factory.createClienteConOfferta(
+			{ ragioneSociale: `E2E Giornata Intera ${seed}` },
+			{ codice: `INTERA-${seed}`.toUpperCase(), tariffaGiornaliera: TARIFFA_OFFERTA },
+		);
+		await factory.createRigaAttivita({
+			collaboratore: marco,
+			cliente,
+			offerta,
+			data: dataDb(meseRiepilogo, 12),
+			ore: "8.00",
+			fatturabile: true,
+		});
+
+		await accediComeCollaboratore(page, marco.utente.email);
+		await apriRiepilogo(page, meseRiepilogo);
+
+		await expect(page.getByTestId("summary-giornate-fatturabili")).toContainText("1,00");
+		await expect(page.getByTestId("summary-importo-fattura-value")).toHaveText(/400,00/);
+	});
+
+	test("l'avanzamento offerta conta 0,75 giornate erogate per due righe da 3 ore", async ({
+		page,
+		factory,
+	}) => {
+		const seed = randomUUID().slice(0, 8);
+		const codice = `E2E-FRAZ-AVZ-${seed}`.toUpperCase();
+		const ada = await factory.createCollaboratore({
+			nome: "Ada",
+			cognome: `Esempio ${seed}`,
+			tariffaGiornaliera: TARIFFA_COLLABORATORE,
+		});
+		const { cliente, offerta } = await factory.createClienteConOfferta(
+			{ ragioneSociale: `E2E Avanzamento Frazionario ${seed}` },
+			{ codice, giorniPrevisti: 10, tariffaGiornaliera: TARIFFA_OFFERTA },
+		);
+		for (const giorno of [12, 19]) {
+			await factory.createRigaAttivita({
+				collaboratore: ada,
+				cliente,
+				offerta,
+				data: dataDb(meseRiepilogo, giorno),
+				ore: "3.00",
+				fatturabile: true,
+			});
+		}
+
+		await accediAlBackOfficeComeAdmin(page);
+		await apriPaginaOfferte(page);
+
+		const riga = page.getByRole("row", { name: testoLetterale(codice) });
+		await expect(riga).toBeVisible();
+		await riga.getByRole("button", { name: `Dettaglio avanzamento ${codice}` }).click();
+
+		const dettaglio = page.getByRole("region", { name: `Dettaglio avanzamento ${codice}` });
+		await expect(dettaglio).toBeVisible();
+		// 0,75 gg mostrati con un decimale → "0,8"; troncando per riga sarebbe 0,74 → "0,7"
+		await expect(indicatore(dettaglio, "Erogate")).toContainText(/0,8\s*gg/);
+		await expect(dettaglio.getByText("8%", { exact: true })).toBeVisible();
+	});
+});
